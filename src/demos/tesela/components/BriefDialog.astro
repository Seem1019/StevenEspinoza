---
/**
 * Project brief. Opens via openUi({ brief: '<format>|any' }) (deep link ?brief=pilot, Back closes).
 * Validation on submit, simulated success. Nothing is sent anywhere.
 */
import { useT, type Lang } from '../../../i18n';
import Logo from './Logo.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang, 'tesela');
const kinds = t.raw<{ id: string; label: string }[]>('brief.kinds');
const formats = t.raw<{ id: string; name: string; duration: string }[]>('formats.items');
---
<dialog id="ts-brief" class="ts-dlg ts-dlg--brief" aria-labelledby="ts-brief-title">
  <div class="ts-dlg__panel">
    <button type="button" class="ts-ghost ts-dlg__close" data-ts-close aria-label={t('a11y.close')}>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 3.5l9 9m0-9l-9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    </button>
    <div data-view="form">
      <Logo size={28} />
      <h2 id="ts-brief-title" class="ts-title-lg ts-brief__title">{t('brief.title')}</h2>
      <p class="ts-muted">{t('brief.lead')}</p>
      <form class="ts-form" novalidate data-ts-form>
        <div class="ts-field">
          <label for="ts-name">{t('brief.name')}</label>
          <input id="ts-name" name="name" type="text" autocomplete="name" placeholder={t('brief.namePh')} aria-describedby="ts-name-err" required />
          <p class="ts-err" id="ts-name-err" data-required={t('brief.nameRequired')}></p>
        </div>
        <div class="ts-field">
          <label for="ts-email">{t('brief.email')}</label>
          <input id="ts-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder={t('brief.emailPh')} aria-describedby="ts-email-err" required />
          <p class="ts-err" id="ts-email-err" data-required={t('brief.emailRequired')} data-invalid={t('brief.emailInvalid')}></p>
        </div>
        <fieldset class="ts-kinds">
          <legend>{t('brief.kind')}</legend>
          {kinds.map((k, i) => (
            <label class="ts-kind"><input type="radio" name="kind" value={k.id} checked={i === 0} /><span>{k.label}</span></label>
          ))}
        </fieldset>
        <div class="ts-field">
          <label for="ts-format">{t('brief.format')}</label>
          <select id="ts-format" name="format" data-ts-format>
            <option value="any">{t('brief.formatAny')}</option>
            {formats.map((f) => <option value={f.id}>{f.name} · {f.duration}</option>)}
          </select>
        </div>
        <div class="ts-field">
          <label for="ts-msg">{t('brief.message')}</label>
          <textarea id="ts-msg" name="message" rows="3" placeholder={t('brief.messagePh')}></textarea>
        </div>
        <button type="submit" class="ts-btn ts-btn--primary ts-btn--block">{t('brief.submit')}</button>
        <p class="ts-mono ts-muted ts-note">{t('brief.demoNote')}</p>
      </form>
    </div>
    <div class="ts-success" data-view="success" hidden>
      <Logo size={28} />
      <h2 class="ts-title-lg" tabindex="-1" data-ts-ok-title data-tpl={t('brief.successTitle')}></h2>
      <p class="ts-muted" data-ts-ok-text data-tpl={t('brief.successText')}></p>
      <button type="button" class="ts-btn ts-btn--primary ts-btn--block" data-ts-close>{t('brief.successCta')}</button>
      <p class="ts-mono ts-muted ts-note">{t('brief.demoNote')}</p>
    </div>
    <p class="sr-only" aria-live="polite" data-ts-live></p>
  </div>
</dialog>
