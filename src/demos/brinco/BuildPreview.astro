---
/**
 * Static 1280px miniature of Brinco for the agents showcase + gallery thumbnail. No JS, no network:
 * product art is the public sprite inlined at build time (ids prefixed to avoid collisions).
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { useT, type Lang } from '../../i18n';
import Wheel from './Wheel.astro';
import { buildCatalog, decode, flashPicks, locale, BG, FREE_SHIP, type Vocab } from './catalog';
import { money, moneyShort } from './format';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang, 'brinco');
const loc = locale(lang);
const all = buildCatalog(t.raw<Vocab>('catalogVocab'));
const cards = all.slice(0, 5).map(decode);
const flash = flashPicks(all).slice(0, 6).map(decode);
let sprite = '';
try {
  sprite = readFileSync(join(process.cwd(), 'public/demos/brinco/sprite.svg'), 'utf8')
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/<svg[^>]*>/, '')
    .replace('</svg>', '')
    .replace(/id="i(\d+)"/g, 'id="bpb-i$1"');
} catch { /* preview still renders without art */ }
const free = moneyShort(FREE_SHIP, loc);
const ticker = t.raw<string[]>('ticker.items').slice(0, 3).map((s) => s.replace('{free}', free));
const cats = t.raw<Vocab>('catalogVocab').cats;
---

<div class="bpb" data-lang={lang}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" set:html={sprite} />
  <div class="bpb-ticker" data-build="ticker">{ticker.map((s) => <span>{s}</span>)}</div>
  <div class="bpb-header" data-build="header">
    <span class="bpb-logo"><b>b</b>brinco</span>
    <span class="bpb-search">{t('header.searchPlaceholder')}<i></i></span>
    <span class="bpb-cart">{t('header.cart')}<em>3</em></span>
  </div>
  <section class="bpb-hero" data-build="hero">
    <div data-build="title">
      <p class="bpb-kicker">{t('hero.kicker')}</p>
      <p class="bpb-h1">{t('hero.title')}</p>
      <p class="bpb-sub">{t('hero.sub', { free })}</p>
      <p class="bpb-ctas"><span class="bpb-btn bpb-btn--l">{t('hero.ctaShop')}</span><span class="bpb-btn bpb-btn--p">{t('hero.ctaSpin')}</span></p>
    </div>
    <div class="bpb-wheelbox" data-build="wheel">
      <span class="bpb-st bpb-st--a">{t('hero.stickerOff')}</span>
      <span class="bpb-st bpb-st--b">{t('hero.stickerShip')}</span>
      <span class="bpb-pin"></span>
      <div class="bpb-wheel"><Wheel labels={t.raw<string[]>('wheel.segments')} /></div>
    </div>
  </section>
  <section class="bpb-flash" data-build="flash">
    <div class="bpb-flash__head">
      <p class="bpb-h2">{t('flash.title')}</p>
      <p class="bpb-cd" data-build="timer"><span>{t('flash.ends')}</span><b>07<i>{t('flash.h')}</i></b><b>42<i>{t('flash.m')}</i></b><b>19<i>{t('flash.s')}</i></b></p>
    </div>
    <div class="bpb-flash__row">
      {flash.map((p) => (
        <div class="bpb-fc">
          <span class="bpb-fc__art" style={`--bg:${BG[p.bg]}`}><svg viewBox="0 0 64 64"><use href={`#bpb-i${p.icon}`} /></svg><em>-{p.off}%</em></span>
          <strong>{money(p.price, loc)}</strong>
          <span class="bpb-bar"><i style={`transform:scaleX(${0.6 + (p.id % 4) / 10})`}></i></span>
          <small>{t('flash.left', { n: p.stock })}</small>
        </div>
      ))}
    </div>
  </section>
  <section class="bpb-cat">
    <p class="bpb-h2 bpb-h2--dark">{t('catalog.title')}</p>
    <p class="bpb-chips"><span class="is-on">{t('catalog.all')}</span>{cats.slice(0, 6).map((c) => <span>{c}</span>)}</p>
    <div class="bpb-grid" data-build="grid">
      {cards.map((p, i) => (
        <div class="bpb-card" data-build={`card${i + 1}`}>
          <span class="bpb-card__art" style={`--bg:${BG[p.bg]}`}><svg viewBox="0 0 64 64"><use href={`#bpb-i${p.icon}`} /></svg><em>-{p.off}%</em></span>
          <span class="bpb-card__name">{p.name}</span>
          <span class="bpb-card__price"><strong>{money(p.price, loc)}</strong> <s>{money(p.orig, loc)}</s></span>
          <span class="bpb-card__add">+ {t('card.add')}</span>
        </div>
      ))}
    </div>
  </section>
  <footer class="bpb-footer" data-build="footer">
    <span class="bpb-logo bpb-logo--foot"><b>b</b>brinco</span>
    <p>{t('footer.note')}</p>
  </footer>
</div>

<style>
  .bpb {
    --o: #0b0c10; --o2: #14151a; --a: #ff3b1d; --ai: #d42a0e; --k: #09090b; --k2: #3f3f46; --mu: #52525b; --tr: #e4e4e7;
    --hair: 0 0 0 1px rgb(0 0 0 / 0.07), 0 2px 8px -2px rgb(0 0 0 / 0.04); --hd: 0 0 0 1px rgb(255 255 255 / 0.09);
    --mono: var(--font-brinco-mono, ui-monospace), ui-monospace, monospace;
    width: 1280px; background: #f4f4f5; color: var(--k); font-family: var(--font-brinco, system-ui), system-ui, sans-serif; overflow: hidden; line-height: 1.2;
  }
  .bpb p { margin: 0; }
  .bpb-ticker { height: 34px; display: flex; gap: 52px; align-items: center; padding: 0 24px; background: var(--o); color: #a1a1aa; font-weight: 500; font-size: 13px; white-space: nowrap; overflow: hidden; box-shadow: inset 0 -1px 0 rgb(255 255 255 / 0.06); }
  .bpb-ticker span::after { content: ''; display: inline-block; width: 4px; height: 4px; margin-left: 26px; border-radius: 50%; background: var(--a); vertical-align: 2px; }
  .bpb-header { height: 68px; display: flex; align-items: center; gap: 22px; padding: 0 40px; background: var(--o); color: #fafafa; box-shadow: inset 0 -1px 0 rgb(255 255 255 / 0.08); }
  .bpb-logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 700; font-size: 21px; letter-spacing: -0.045em; }
  .bpb-logo b { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: var(--a); color: var(--o); font-size: 18px; }
  .bpb-search { flex: 1; height: 44px; display: flex; align-items: center; padding-left: 14px; border-radius: 10px; background: var(--o2); box-shadow: var(--hd); color: #a1a1aa; font-size: 15px; position: relative; }
  .bpb-search i { position: absolute; right: 16px; top: 50%; width: 14px; height: 14px; margin-top: -8px; border: 1.8px solid #a1a1aa; border-radius: 50%; }
  .bpb-cart { position: relative; height: 44px; display: inline-flex; align-items: center; padding: 0 16px; border-radius: 10px; background: var(--o2); box-shadow: var(--hd); font-weight: 500; font-size: 15px; }
  .bpb-cart em { position: absolute; top: -7px; right: -7px; min-width: 22px; height: 22px; display: grid; place-items: center; font-style: normal; border-radius: 6px; background: var(--a); color: var(--o); font-family: var(--mono); font-weight: 700; font-size: 12px; box-shadow: 0 0 0 2px var(--o); }
  .bpb-hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; align-items: center; padding: 64px 40px; color: #fafafa; background: radial-gradient(42% 70% at 78% 42%, rgb(255 59 29 / 0.07), transparent 70%), radial-gradient(70% 90% at 20% 0%, rgb(255 255 255 / 0.03), transparent 70%), var(--o); }
  .bpb-kicker { display: inline-block; padding: 6px 10px; margin-bottom: 18px !important; border-radius: 6px; box-shadow: var(--hd); color: #a1a1aa; font-weight: 500; font-size: 13px; }
  .bpb-h1 { font-weight: 700; font-size: 74px; line-height: 1.08; letter-spacing: -0.035em; max-width: 13ch; }
  .bpb-sub { margin-top: 18px !important; font-size: 18px; line-height: 1.55; color: #a1a1aa; max-width: 46ch; }
  .bpb-ctas { display: flex; gap: 12px; margin-top: 28px !important; }
  .bpb-btn { display: inline-flex; align-items: center; height: 52px; padding: 0 24px; border-radius: 6px; font-weight: 600; font-size: 16px; letter-spacing: -0.011em; }
  .bpb-btn--l { background: #fff; color: var(--k); }
  .bpb-btn--p { background: var(--a); color: var(--o); box-shadow: 0 6px 18px -8px rgb(255 59 29 / 0.65); }
  .bpb-wheelbox { position: relative; height: 360px; display: grid; place-items: center; }
  .bpb-wheel { width: 320px; height: 320px; }
  .bpb-wheel :global(svg) { width: 100%; height: 100%; }
  .bpb-pin { position: absolute; z-index: 2; top: 14px; left: 50%; width: 12px; height: 22px; margin-left: -6px; background: var(--a); clip-path: polygon(0 0, 100% 0, 100% 58%, 50% 100%, 0 58%); }
  .bpb-st { position: absolute; z-index: 3; padding: 8px 11px; border-radius: 6px; background: rgb(20 21 26 / 0.92); box-shadow: var(--hd), 0 14px 32px -14px rgb(0 0 0 / 0.8); font-weight: 600; font-size: 13px; color: #fafafa; }
  .bpb-st--a { left: 0; top: 18px; padding: 10px 12px; font-family: var(--mono); font-size: 36px; font-weight: 700; letter-spacing: -0.04em; color: var(--a); }
  .bpb-st--b { right: 0; bottom: 24px; }
  .bpb-flash { background: #fafafa; padding: 32px 40px 30px; box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.06); }
  .bpb-flash__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .bpb-h2 { font-weight: 700; font-size: 34px; letter-spacing: -0.035em; }
  .bpb-cd { display: flex; gap: 6px; align-items: center; font-weight: 500; font-size: 13px; color: var(--mu); }
  .bpb-cd span { margin-right: 4px; }
  .bpb-cd b { display: inline-flex; align-items: baseline; gap: 3px; min-width: 56px; justify-content: center; padding: 7px 9px; border-radius: 6px; background: var(--o); color: #fafafa; font-family: var(--mono); font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .bpb-cd b i { font-style: normal; font-size: 11px; font-weight: 500; color: #a1a1aa; }
  .bpb-flash__row { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .bpb-fc { display: grid; gap: 7px; padding-bottom: 12px; border-radius: 10px; background: #fff; box-shadow: var(--hair); }
  .bpb-fc > :not(.bpb-fc__art) { margin-inline: 12px; }
  .bpb-fc__art, .bpb-card__art { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: 10px 10px 0 0; background: radial-gradient(80% 70% at 50% 38%, #fff, var(--bg) 72%); }
  .bpb-fc__art svg { width: 52%; height: 52%; }
  .bpb-fc__art em, .bpb-card__art em { position: absolute; left: 8px; top: 8px; padding: 3px 6px; border-radius: 4px; font-style: normal; background: var(--a); color: var(--o); font-family: var(--mono); font-weight: 700; font-size: 13px; letter-spacing: -0.03em; }
  .bpb-fc strong, .bpb-card__price strong { font-family: var(--mono); color: var(--ai); font-weight: 700; font-size: 18px; letter-spacing: -0.035em; }
  .bpb-bar { display: block; height: 4px; border-radius: 2px; background: var(--tr); overflow: hidden; }
  .bpb-bar i { display: block; height: 100%; background: var(--a); transform-origin: left; }
  .bpb-fc small { font-weight: 600; font-size: 12px; color: var(--ai); }
  .bpb-cat { padding: 36px 40px 36px; }
  .bpb-chips { display: flex; gap: 6px; margin: 16px 0 20px !important; }
  .bpb-chips span { padding: 11px 14px; border-radius: 8px; background: #fff; box-shadow: var(--hair); font-weight: 500; font-size: 14px; color: var(--k2); }
  .bpb-chips span.is-on { background: var(--o); color: #fafafa; }
  .bpb-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .bpb-card { display: grid; gap: 6px; padding-bottom: 12px; border-radius: 14px; background: #fff; box-shadow: var(--hair); }
  .bpb-card > :not(.bpb-card__art) { margin-inline: 12px; }
  .bpb-card__art { aspect-ratio: 1; border-radius: 14px 14px 0 0; }
  .bpb-card__art svg { width: 54%; height: 54%; }
  .bpb-card__name { font-weight: 500; font-size: 14px; color: var(--k2); }
  .bpb-card__price s { font-family: var(--mono); color: var(--mu); font-size: 12px; }
  .bpb-card__add { height: 40px; display: grid; place-items: center; border-radius: 8px; background: var(--o); color: #fafafa; font-weight: 600; font-size: 14px; }
  .bpb-footer { display: flex; gap: 32px; align-items: center; padding: 36px 40px 44px; background: #070709; color: #a1a1aa; font-size: 14px; }
  .bpb-logo--foot { color: #fafafa; }
  .bpb-footer p { max-width: 70ch; }

  @media (prefers-reduced-motion: no-preference) {
    .bpb-wheelbox[data-build-state='motion'] .bpb-wheel :global(svg) { animation: bpb-spin 6s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
    .bpb-ticker[data-build-state='motion'] span { animation: bpb-slide 6s linear infinite; }
    .bpb-flash[data-build-state='motion'] .bpb-bar i { animation: bpb-fill 1.6s cubic-bezier(0.22, 1, 0.36, 1) infinite alternate; }
    .bpb-cd[data-build-state='motion'] b:last-child { animation: bpb-blink 1s steps(2) infinite; }
    .bpb-card[data-build-state='motion'] .bpb-card__add { animation: bpb-press 1.4s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
  }
  @keyframes bpb-slide { to { transform: translateX(-120px); } }
  @keyframes bpb-spin { from { transform: rotate(0); } to { transform: rotate(1080deg); } }
  @keyframes bpb-fill { from { transform: scaleX(0.3); } }
  @keyframes bpb-blink { 50% { opacity: 0.55; } }
  @keyframes bpb-press { 50% { transform: scale(0.97); } }
</style>
