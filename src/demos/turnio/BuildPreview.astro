---
/** Static 1280px miniature of the Turnio landing for the showcase / gallery thumbnail. No JS. */
import { useT, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang, 'turnio');
type Appt = { d: number; s: number; l: number; t: string; w: string; c: string; n?: boolean };
type Plan = { id: string; name: string; for: string; monthly: number; features: string[]; cta: string };
const days = t.raw<string[]>('mock.days');
const hours = t.raw<string[]>('mock.hours');
const appts = t.raw<Appt[]>('mock.appts');
const names = t.raw<string[]>('proof.names');
const benefits = t.raw<{ metric: string; metricLabel: string; title: string; text: string }[]>('benefits.items');
const plans = t.raw<Plan[]>('pricing.plans');
const faqs = t.raw<{ q: string }[]>('faq.items').slice(0, 3);
---
<div class="bp" data-lang={lang}>
  <header class="bp-header" data-build="header">
    <span class="bp-logo"><svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#7CF3B6" /><path d="M9 12.5h14M16 12.5V23" stroke="#062B20" stroke-width="3.2" stroke-linecap="round" /><circle cx="22.5" cy="21.5" r="2.4" fill="#FFB547" /></svg>turnio</span>
    <nav><span>{t('nav.product')}</span><span>{t('nav.how')}</span><span>{t('nav.pricing')}</span><span>{t('nav.faq')}</span></nav>
    <span class="bp-btn bp-btn--mint bp-btn--sm">{t('nav.cta')}</span>
  </header>

  <section class="bp-hero">
    <div class="bp-hero__copy" data-build="hero-copy">
      <p class="bp-eyebrow"><i></i>{t('hero.eyebrow')}</p>
      <h2><span>{t('hero.titleA')}</span> {t('hero.titleB')}</h2>
      <p class="bp-sub">{t('hero.subtitle')}</p>
      <div class="bp-ctas" data-build="hero-cta">
        <span class="bp-btn bp-btn--mint">{t('hero.cta')} →</span>
        <span class="bp-btn bp-btn--ghost">{t('hero.ctaSecondary')}</span>
      </div>
    </div>
    <div class="bp-mock" data-build="mock">
      <div class="bp-mock__bar"><i></i><i></i><i></i><b>{t('mock.app')}</b><span>{t('mock.newBooking')}</span></div>
      <div class="bp-mock__head"><b>{t('mock.week')}</b></div>
      <div class="bp-cal">
        {days.map((d, i) => <span class="bp-cal__day" style={`grid-column:${i + 2}`}>{d}</span>)}
        {hours.map((h, i) => <span class="bp-cal__hour" style={`grid-row:${i * 2 + 2} / span 2`}>{h}</span>)}
        {appts.map((a) => (
          <span class={`bp-appt bp-appt--${a.c}${a.n ? ' is-new' : ''}`} style={`grid-column:${a.d + 2};grid-row:${a.s + 2} / span ${a.l}`}>
            <b>{a.t}</b><span>{a.w}</span>
          </span>
        ))}
      </div>
      <div class="bp-toast" data-build="toast">
        <i></i><span><b>{t('mock.toastTitle')}</b><small>{t('mock.toastBody')}</small></span><em>{t('mock.toastStatus')}</em>
      </div>
      <div class="bp-widget" data-build="widget">
        <b>{t('mock.widgetTitle')}</b>
        <small>{t('mock.widgetService')}</small>
        <span class="bp-slots">{t.raw<string[]>('mock.widgetSlots').map((s, i) => <span class={i === 1 ? 'on' : ''}>{s}</span>)}</span>
        <span class="bp-widget__cta">{t('mock.widgetCta')}</span>
      </div>
      <div class="bp-chip"><small>{t('mock.chip')}</small><b>{t('mock.chipValue')}</b></div>
    </div>
  </section>

  <section class="bp-logos" data-build="logos">
    <span class="bp-sample">{t('proof.label')}</span>
    {names.map((n) => <span class="bp-mark"><i></i>{n}</span>)}
  </section>

  <section class="bp-section">
    <div class="bp-head"><h3>{t('benefits.title')}</h3><span class="bp-sample">{t('benefits.label')}</span></div>
    <div class="bp-grid3" data-build="benefits">
      {benefits.map((b) => (
        <div class="bp-card">
          <p class="bp-metric"><b>{b.metric}</b> {b.metricLabel}</p>
          <h4>{b.title}</h4>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bp-section bp-section--tint">
    <div class="bp-head bp-head--c"><h3>{t('pricing.title')}</h3>
      <span class="bp-toggle"><span class="on">{t('pricing.monthly')}</span><span>{t('pricing.annual')} <em>{t('pricing.save')}</em></span></span>
    </div>
    <div class="bp-grid3 bp-plans" data-build="pricing">
      {plans.map((p) => (
        <div class={`bp-plan${p.id === 'pro' ? ' bp-plan--pop' : ''}`}>
          {p.id === 'pro' && <em class="bp-badge">{t('pricing.popular')}</em>}
          <b class="bp-plan__name">{p.name}</b>
          <small>{p.for}</small>
          <p class="bp-price"><b>{t('pricing.price', { n: p.monthly })}</b>{t('pricing.per')}</p>
          <span class={`bp-btn ${p.id === 'pro' ? 'bp-btn--mint' : 'bp-btn--dark'}`}>{p.cta}</span>
          <ul>{p.features.slice(0, 3).map((f) => <li>{f}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="bp-section bp-faq">
    <h3>{t('faq.title')}</h3>
    <div class="bp-faq__list" data-build="faq">
      {faqs.map((f) => <div class="bp-qa"><span>{f.q}</span><i>+</i></div>)}
    </div>
  </section>

  <section class="bp-final" data-build="final">
    <h3>{t('final.title')}</h3>
    <span class="bp-btn bp-btn--mint">{t('final.cta')} →</span>
  </section>

  <footer class="bp-footer" data-build="footer">
    <span class="bp-logo bp-logo--dark"><svg viewBox="0 0 32 32" width="24" height="24" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#0B3D2E" /><path d="M9 12.5h14M16 12.5V23" stroke="#7CF3B6" stroke-width="3.2" stroke-linecap="round" /></svg>turnio</span>
    <small>{t('footer.rights')}</small>
  </footer>
</div>

<style>
  .bp {
    --f: #0b3d2e; --f7: #11533f; --m: #7cf3b6; --m1: #dff9ec; --m0: #f0fcf6; --a: #ffb547; --a1: #fff1db;
    --ink: #0f2a22; --mu: #4b635a; --line: #d5e6dd; --od: #cde7db;
    width: 1280px; background: #fff; color: var(--ink); overflow: hidden;
    font-family: var(--font-turnio, 'Plus Jakarta Sans'), system-ui, sans-serif; font-size: 14px; line-height: 1.45;
  }
  .bp :global(*) { box-sizing: border-box; margin: 0; }
  .bp ul { list-style: none; padding: 0; }
  .bp-header { height: 64px; display: flex; align-items: center; gap: 24px; padding: 0 56px; background: var(--f); color: #fff; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .bp-logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 22px; letter-spacing: -0.03em; }
    .bp-logo--dark { color: var(--f); font-size: 18px; }
    .bp-header nav { margin-left: auto; display: flex; gap: 28px; color: var(--od); font-weight: 600; font-size: 15px; }
  .bp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 20px; border-radius: 10px; font-weight: 700; font-size: 16px; white-space: nowrap; }
  .bp-btn--sm { min-height: 40px; font-size: 14px; padding: 0 14px; }
  .bp-btn--mint { background: var(--m); color: #062b20; }
  .bp-btn--ghost { border: 1px solid rgb(255 255 255 / 0.32); color: #fff; }
  .bp-btn--dark { background: var(--f); color: #fff; }

  .bp-hero { display: grid; grid-template-columns: 1fr 1.12fr; gap: 48px; align-items: center; padding: 48px 56px 72px; background: var(--f); color: #fff; }
  .bp-eyebrow { display: inline-flex; align-items: center; gap: 8px; color: #b5f7d5; font-weight: 600; margin-bottom: 16px; }
  .bp-eyebrow i { width: 8px; height: 8px; border-radius: 50%; background: var(--a); }
  .bp-hero h2 { font-size: 52px; line-height: 1.06; font-weight: 800; letter-spacing: -0.03em; }
  .bp-hero h2 span { display: block; color: var(--m); }
  .bp-sub { margin-top: 18px; color: var(--od); font-size: 17px; line-height: 1.6; }
  .bp-ctas { display: flex; gap: 12px; margin-top: 28px; }

  .bp-mock { position: relative; background: #fff; color: var(--ink); border-radius: 16px; box-shadow: 0 12px 40px rgb(4 31 23 / 0.3); padding: 0 14px 14px; font-size: 11px; }
  .bp-mock__bar { display: flex; align-items: center; gap: 6px; height: 42px; margin: 0 -14px 10px; padding: 0 14px; border-bottom: 1px solid var(--line); }
  .bp-mock__bar i { width: 9px; height: 9px; border-radius: 50%; background: #d8e3dd; }
  .bp-mock__bar b { margin-left: 8px; font-size: 13px; }
  .bp-mock__bar span { margin-left: auto; padding: 4px 10px; border-radius: 6px; background: var(--f); color: #fff; font-weight: 700; }
  .bp-mock__head { margin-bottom: 8px; font-size: 13px; }
  .bp-cal { display: grid; grid-template-columns: 40px repeat(5, 1fr); grid-template-rows: 24px repeat(10, 27px); column-gap: 5px; }
  .bp-cal__day { grid-row: 1; font-weight: 700; color: var(--mu); }
  .bp-cal__hour { grid-column: 1; color: #52685e; font-size: 10px; }
  .bp-appt { position: relative; margin: 2px 0; padding: 3px 6px; border-radius: 6px; display: flex; flex-direction: column; overflow: hidden; font-size: 10.5px; line-height: 1.3; }
  .bp-appt b { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bp-appt--a { background: var(--m1); color: var(--f); }
  .bp-appt--b { background: var(--a1); color: #6b3f00; }
  .bp-appt--c { background: #e3ede8; color: var(--f7); }
  .bp-appt.is-new { background: var(--f); color: #fff; overflow: visible; }
  .bp-toast { position: absolute; right: -12px; top: 58px; width: 290px; display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: center; padding: 10px 12px; background: #fff; border-radius: 12px; box-shadow: 0 12px 40px rgb(4 31 23 / 0.28); }
  .bp-toast > i { width: 30px; height: 30px; border-radius: 8px; background: var(--f); }
  .bp-toast span { display: grid; }
  .bp-toast small { color: var(--mu); }
  .bp-toast em { font-style: normal; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: var(--m1); color: var(--f); }
  .bp-widget { position: absolute; left: -28px; bottom: -36px; width: 230px; display: grid; gap: 7px; padding: 14px; background: #fff; border-radius: 12px; box-shadow: 0 12px 40px rgb(4 31 23 / 0.28); }
  .bp-widget small { color: var(--mu); }
  .bp-slots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
  .bp-slots span { text-align: center; padding: 4px 0; border: 1px solid var(--line); border-radius: 6px; font-weight: 600; }
  .bp-slots .on { background: var(--f); color: #fff; border-color: var(--f); }
  .bp-widget__cta { text-align: center; padding: 7px; border-radius: 8px; background: var(--m); font-weight: 700; color: #062b20; }
  .bp-chip { position: absolute; right: 36px; bottom: -22px; display: grid; padding: 8px 12px; border-radius: 10px; background: var(--a); color: #062b20; font-weight: 600; }
  .bp-chip b { font-size: 20px; line-height: 1.2; font-weight: 800; }

  .bp-logos { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 28px 56px; border-bottom: 1px solid var(--line); }
  .bp-mark { display: inline-flex; align-items: center; gap: 8px; color: #3f5850; font-weight: 800; font-size: 16px; }
  .bp-mark i { width: 16px; height: 16px; border-radius: 50%; background: currentColor; }
  .bp-sample { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 6px; background: var(--a1); color: #6b3f00; font-weight: 700; font-size: 12px; white-space: nowrap; }

  .bp-section { padding: 56px; }
  .bp-section--tint { background: var(--m0); }
  .bp-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .bp-head--c { flex-direction: column; text-align: center; }
  .bp h3 { font-size: 36px; line-height: 1.1; font-weight: 800; letter-spacing: -0.025em; }
  .bp-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .bp-card { border: 1px solid var(--line); border-radius: 16px; padding: 24px; display: grid; gap: 10px; }
  .bp-metric { color: var(--mu); font-weight: 600; }
  .bp-metric b { font-size: 44px; line-height: 1; font-weight: 800; color: var(--f); letter-spacing: -0.04em; }
  .bp-card h4 { font-size: 19px; font-weight: 700; }
  .bp-card p:last-child { color: var(--mu); }

  .bp-toggle { display: inline-flex; gap: 4px; padding: 4px; border-radius: 14px; background: #fff; border: 1px solid var(--line); font-weight: 700; }
  .bp-toggle span { padding: 10px 16px; border-radius: 10px; }
  .bp-toggle .on { background: var(--f); color: #fff; }
  .bp-toggle em { font-style: normal; padding: 2px 6px; border-radius: 6px; background: var(--a); font-size: 12px; }
  .bp-plans { align-items: start; }
  .bp-plan { position: relative; display: grid; gap: 6px; padding: 28px 24px; border-radius: 16px; border: 1px solid var(--line); background: #fff; }
  .bp-plan small { color: var(--mu); }
  .bp-plan__name { font-size: 20px; font-weight: 800; }
  .bp-price { margin: 12px 0 16px; color: var(--mu); font-weight: 600; }
  .bp-price b { font-size: 46px; line-height: 1; font-weight: 800; letter-spacing: -0.04em; color: var(--ink); }
  .bp-plan ul { display: grid; gap: 8px; margin-top: 18px; }
  .bp-plan li::before { content: '✓'; margin-right: 8px; color: #1b6b52; font-weight: 800; }
  .bp-plan--pop { background: var(--f); border-color: var(--f); color: #fff; margin-top: -12px; padding-block: 40px; box-shadow: 0 12px 40px rgb(4 31 23 / 0.28); }
  .bp-plan--pop small, .bp-plan--pop .bp-price { color: var(--od); }
  .bp-plan--pop .bp-price b { color: #fff; }
  .bp-plan--pop li::before { color: var(--m); }
  .bp-badge { position: absolute; top: -12px; right: 20px; padding: 4px 10px; border-radius: 8px; background: var(--a); color: #062b20; font-style: normal; font-weight: 800; font-size: 12px; }

  .bp-faq { display: grid; grid-template-columns: 4fr 8fr; gap: 56px; align-items: start; }
  .bp-faq__list { display: grid; gap: 12px; }
  .bp-qa { display: flex; justify-content: space-between; align-items: center; min-height: 56px; padding: 0 20px; border: 1px solid var(--line); border-radius: 12px; font-weight: 700; font-size: 15px; }
  .bp-qa i { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 8px; background: var(--m1); color: var(--f); font-style: normal; font-weight: 800; }

  .bp-final { display: grid; justify-items: center; gap: 24px; padding: 56px; background: var(--f); color: #fff; text-align: center; }
  .bp-final h3 { font-size: 48px; }
  .bp-footer { display: flex; justify-content: space-between; align-items: center; padding: 28px 56px; border-top: 1px solid var(--line); color: var(--mu); }

  @media (prefers-reduced-motion: no-preference) {
    [data-build-state='motion'] .bp-toast, [data-build-state='motion'].bp-toast { animation: bp-float 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate; }
    [data-build-state='motion'].bp-widget { animation: bp-float 3s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate-reverse; }
    [data-build-state='motion'] .bp-appt.is-new { animation: bp-pulse 1.6s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
    [data-build-state='motion'] .bp-plan--pop { animation: bp-lift 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate; }
  }
  @keyframes bp-float { to { transform: translateY(-8px); } }
  @keyframes bp-pulse { 50% { transform: scale(1.05); opacity: 0.85; } }
  @keyframes bp-lift { to { transform: translateY(-6px); } }
</style>
