---
/** Scene 4 — the table. Back: dining room with bokeh. Mid: set table with dishes + candle. Front: chair and bottle silhouettes. */
import '../../styles/art.css';
interface Props { p?: string }
const { p = 'lbM' } = Astro.props;
const id = (s: string) => `${p}-${s}`;
const url = (s: string) => `url(#${id(s)})`;
const bokeh = [
  { x: 180, y: 120, w: 90, t: 5, d: -1 }, { x: 420, y: 70, w: 70, t: 6, d: -3 }, { x: 640, y: 150, w: 110, t: 4.5, d: -2 },
  { x: 880, y: 60, w: 80, t: 5.5, d: -4 }, { x: 1040, y: 160, w: 100, t: 6.5, d: -1.5 }, { x: 1300, y: 90, w: 90, t: 5, d: -2.5 },
  { x: 760, y: 260, w: 60, t: 4, d: -0.5 }, { x: 1440, y: 230, w: 70, t: 6, d: -3.5 },
];
---
<div class="lb-cam">
  <div class="lb-push">
    <div class="lb-layer lb-layer--back">
      <svg class="lb-svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id={id('room')} cx="0.5" cy="0.55" r="0.7">
            <stop offset="0" stop-color="#4a2614" />
            <stop offset="0.6" stop-color="#22140d" />
            <stop offset="1" stop-color="#110a07" />
          </radialGradient>
          <linearGradient id={id('night')} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0a0b12" />
            <stop offset="1" stop-color="#22150f" />
          </linearGradient>
          <radialGradient id={id('sconce')}>
            <stop offset="0" stop-color="#ffd28a" stop-opacity="0.6" />
            <stop offset="1" stop-color="#ffd28a" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="1600" height="1000" fill={url('room')} />
        <!-- arched window to the night -->
        <path d="M640 560V250a160 160 0 0 1 320 0v310z" fill={url('night')} />
        <path d="M640 560V250a160 160 0 0 1 320 0v310" fill="none" stroke="#3a2618" stroke-width="14" />
        <path d="M800 90v470M640 330h320" stroke="#3a2618" stroke-width="8" />
        <!-- wainscot -->
        <rect x="0" y="520" width="1600" height="480" fill="#1a0f0a" />
        <rect x="0" y="514" width="1600" height="10" fill="#3a2618" />
        {[440, 1160].map((x) => (
          <g>
            <circle cx={x} cy="330" r="120" fill={url('sconce')} />
            <path d={`M${x - 14} 360h28l-6 30h-16z`} fill="#8d6a32" />
            <path d={`M${x - 18} 320h36l-8 40h-20z`} fill="#ffcf7a" />
          </g>
        ))}
      </svg>
      {bokeh.map((b) => (
        <div class="lb-at lb-bokeh lb-fx" style={`--x:${b.x};--y:${b.y};--w:${b.w};--h:${b.w};--t:${b.t}s;--d:${b.d}s`}></div>
      ))}
    </div>

    <div class="lb-layer lb-layer--mid">
      <svg class="lb-svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id={id('wood')} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#74401e" />
            <stop offset="1" stop-color="#2e180c" />
          </linearGradient>
          <radialGradient id={id('candle')} cx="0.5" cy="0.4" r="0.5">
            <stop offset="0" stop-color="#ffcf7a" stop-opacity="0.75" />
            <stop offset="1" stop-color="#ffcf7a" stop-opacity="0" />
          </radialGradient>
          <radialGradient id={id('plate')} cx="0.45" cy="0.4" r="0.6">
            <stop offset="0" stop-color="#efe4d2" />
            <stop offset="1" stop-color="#bba98f" />
          </radialGradient>
        </defs>
        <path d="M380 580h840l280 420H100z" fill={url('wood')} />
        <path d="M380 580h840" stroke="#a86a3a" stroke-width="4" opacity="0.6" />
        <path d="M600 580l-120 420M1000 580l120 420M800 580v420" stroke="#1a0d06" stroke-width="2" opacity="0.5" />
        <path d="M730 580h140l60 420H670z" fill="#7a2a1a" opacity="0.55" />
        <ellipse cx="800" cy="700" rx="560" ry="230" fill={url('candle')} />
        <!-- back plates: vegetables, bread -->
        <ellipse cx="580" cy="680" rx="96" ry="30" fill={url('plate')} />
        <g fill="#4a6a2a"><ellipse cx="560" cy="676" rx="30" ry="9" /><ellipse cx="600" cy="680" rx="26" ry="8" fill="#9a2a14" /><ellipse cx="580" cy="670" rx="18" ry="6" fill="#d9a03a" /></g>
        <ellipse cx="1020" cy="680" rx="90" ry="28" fill="#5a3a1c" />
        <g fill="#c98a4a"><ellipse cx="1000" cy="668" rx="34" ry="14" /><ellipse cx="1046" cy="672" rx="30" ry="12" fill="#b07436" /></g>
        <path d="M986 662l22-6M1030 666l24-6" stroke="#7a4a1c" stroke-width="3" />
        <!-- candle -->
        <rect x="786" y="604" width="28" height="48" rx="3" fill="#efe4d2" />
        <path d="M772 600h56v56h-56z" fill="#ffe9c4" opacity="0.12" stroke="#ffe9c4" stroke-opacity="0.35" stroke-width="2" />
        <!-- wine glasses -->
        {[690, 910].map((x) => (
          <g transform={`translate(${x} 560)`}>
            <path d="M-26 0h52c2 40-12 62-26 64-14-2-28-24-26-64z" fill="#ffe9c4" fill-opacity="0.1" stroke="#ffe9c4" stroke-opacity="0.5" stroke-width="2" />
            <path d="M-24 28h48c-4 22-12 34-24 36-12-2-20-14-24-36z" fill="#6e1a16" />
            <path d="M0 64v42M-20 108h40" stroke="#ffe9c4" stroke-opacity="0.5" stroke-width="3" />
          </g>
        ))}
        <!-- centre board with sliced grilled meat -->
        <path d="M600 780c0-34 90-56 200-56s200 22 200 56-90 56-200 56-200-22-200-56z" fill="#7a4a24" />
        <path d="M600 780c0 34 90 56 200 56s200-22 200-56v14c0 34-90 56-200 56s-200-22-200-56z" fill="#4a2a12" />
        <g transform="translate(660 744)">
          <path d="M-14 30c-10-12-4-30 14-28" stroke="#efe4d2" stroke-width="12" fill="none" stroke-linecap="round" />
          <path d="M0 30C-4 6 34-8 100-8c66 0 112 12 118 34 6 24-34 44-110 46C34 74 4 56 0 30z" fill="#6a2410" />
          <path d="M6 30C4 14 36 4 100 4c56 0 98 8 104 26" stroke="#a8461c" stroke-width="4" fill="none" opacity="0.6" />
          <g stroke="#2a0c04" stroke-width="7" stroke-linecap="round"><path d="M30 46l44-30M74 56l56-40M126 58l54-38" /></g>
          <path d="M170 10c26 6 42 16 44 30" stroke="#e07a62" stroke-width="8" fill="none" stroke-linecap="round" />
          <g fill="#f6efe6"><circle cx="60" cy="20" r="2.5" /><circle cx="110" cy="30" r="2.5" /><circle cx="150" cy="22" r="2.5" /><circle cx="90" cy="48" r="2.5" /></g>
        </g>
        <ellipse cx="900" cy="770" rx="28" ry="12" fill="#2f5a22" />
        <circle cx="890" cy="766" r="3" fill="#9ad04a" /><circle cx="906" cy="770" r="3" fill="#9ad04a" />
        <!-- chimichurri bowl -->
        <ellipse cx="690" cy="860" rx="54" ry="20" fill="#d8cfc6" />
        <ellipse cx="690" cy="856" rx="44" ry="14" fill="#3a5a1c" />
        <circle cx="680" cy="854" r="3" fill="#c43a10" /><circle cx="700" cy="858" r="3" fill="#c43a10" />
        <!-- front plates + cutlery -->
        {[540, 1060].map((x) => (
          <g>
            <ellipse cx={x} cy="930" rx="150" ry="48" fill={url('plate')} />
            <ellipse cx={x} cy="926" rx="104" ry="32" fill="#f4ecdf" />
            <path d={`M${x - 180} 960l20-70M${x + 180} 960l-16-70`} stroke="#c9c2b8" stroke-width="7" stroke-linecap="round" />
          </g>
        ))}
      </svg>
      <div class="lb-at lb-candle lb-fx" style="--x:792;--y:566;--w:16;--h:40;">
        <svg viewBox="0 0 16 40" aria-hidden="true" focusable="false"><path d="M8 40C2 40 0 34 2 28 4 20 8 16 8 0c4 12 8 20 6 28-1 8-2 12-6 12z" fill="#ffd28a" /><path d="M8 40c-3 0-4-3-3-6s3-5 3-10c2 4 4 8 3 11 0 3-1 5-3 5z" fill="#fffbe8" /></svg>
      </div>
    </div>

    <div class="lb-layer lb-layer--front">
      <svg class="lb-svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <g fill="#070403">
          <path d="M60 1000V560c0-40 30-60 80-60h120c50 0 80 20 80 60v440h-50V620c0-30-20-50-50-50H160c-30 0-50 20-50 50v380z" />
          <path d="M1400 1000V700q0-40 22-56V560h36v84q22 16 22 56v300z" />
        </g>
        <rect x="1408" y="760" width="64" height="70" fill="#e9dcc2" opacity="0.18" />
      </svg>
    </div>
  </div>
</div>
