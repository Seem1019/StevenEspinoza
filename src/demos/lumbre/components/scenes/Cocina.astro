---
/** Scene 3 — open-fire kitchen. Back: tiles, hood, copper pans. Mid: hearth + flames + grill, embers, smoke. Front: the pass. */
import '../../styles/art.css';
interface Props { p?: string }
const { p = 'lbC' } = Astro.props;
const id = (s: string) => `${p}-${s}`;
const url = (s: string) => `url(#${id(s)})`;
const flames = [
  { x: 560, w: 120, h: 190, t: 1.3, d: -0.2 }, { x: 650, w: 150, h: 250, t: 1.1, d: -0.7 },
  { x: 760, w: 170, h: 290, t: 1.5, d: -0.4 }, { x: 870, w: 150, h: 240, t: 1.2, d: -0.9 },
  { x: 960, w: 120, h: 200, t: 1.4, d: -0.1 },
];
const embers = [
  { x: 640, y: 700, t: 3.2, d: -0.4, dx: '2cqw' }, { x: 700, y: 690, t: 2.6, d: -1.8, dx: '-1.5cqw' },
  { x: 760, y: 700, t: 3.6, d: -2.6, dx: '3cqw' }, { x: 800, y: 690, t: 2.9, d: -0.9, dx: '-2.5cqw' },
  { x: 850, y: 700, t: 3.4, d: -1.4, dx: '1.5cqw' }, { x: 900, y: 690, t: 2.7, d: -2.2, dx: '-1cqw' },
  { x: 950, y: 700, t: 3.8, d: -3.1, dx: '2.5cqw' }, { x: 730, y: 700, t: 4.1, d: -0.1, dx: '-3cqw' },
  { x: 880, y: 700, t: 3.1, d: -1.1, dx: '3.5cqw' }, { x: 820, y: 700, t: 4.4, d: -3.6, dx: '-2cqw' },
];
const smokes = [
  { x: 600, y: 420, t: 9, d: -1, dx: '-4cqw' }, { x: 720, y: 400, t: 11, d: -5, dx: '3cqw' }, { x: 840, y: 420, t: 10, d: -8, dx: '-2cqw' },
];
const tiles: { x: number; y: number }[] = [];
for (let y = 0; y < 560; y += 40) for (let x = 0; x < 1600; x += 80) tiles.push({ x: x + ((y / 40) % 2) * 40, y });
---
<div class="lb-cam">
  <div class="lb-push">
    <div class="lb-layer lb-layer--back">
      <svg class="lb-svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id={id('warm')} cx="0.5" cy="0.72" r="0.6">
            <stop offset="0" stop-color="#7a3a18" />
            <stop offset="0.6" stop-color="#2a1810" />
            <stop offset="1" stop-color="#140c08" />
          </radialGradient>
          <linearGradient id={id('hood')} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#1b1513" />
            <stop offset="1" stop-color="#3a2b22" />
          </linearGradient>
          <linearGradient id={id('copper')} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#e0915a" />
            <stop offset="1" stop-color="#7a3a18" />
          </linearGradient>
        </defs>
        <rect width="1600" height="1000" fill={url('warm')} />
        <g fill="none" stroke="#0e0806" stroke-opacity="0.55" stroke-width="2">
          {tiles.map((t) => <rect x={t.x} y={t.y} width="80" height="40" />)}
        </g>
        <!-- hood -->
        <path d="M600 0h400v170l90 150H510l90-150z" fill={url('hood')} />
        <rect x="500" y="316" width="600" height="14" fill="#c9a15a" />
        <path d="M640 40v120M960 40v120" stroke="#0e0a08" stroke-width="4" opacity="0.6" />
        <!-- pan rails + copper pans -->
        {[[250, 470], [1130, 1350]].map(([a, b]) => (
          <g>
            <rect x={a - 20} y="150" width={b - a + 40} height="8" fill="#8d6a32" />
            {[a, (a + b) / 2, b].map((x, i) => (
              <g>
                <path d={`M${x} 158v${30 + i * 8}`} stroke="#8d6a32" stroke-width="3" />
                <path d={`M${x - 4} ${188 + i * 8}h8v60h-8z`} fill="#5a2a10" />
                <circle cx={x} cy={290 + i * 8} r={46 - i * 6} fill={url('copper')} />
                <circle cx={x} cy={290 + i * 8} r={34 - i * 6} fill="#5a2a10" opacity="0.5" />
              </g>
            ))}
          </g>
        ))}
      </svg>
    </div>

    <div class="lb-layer lb-layer--mid">
      <svg class="lb-svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <pattern id={id('brick')} width="70" height="34" patternUnits="userSpaceOnUse">
            <rect width="70" height="34" fill="#5a2c18" />
            <path d="M0 .5h70M0 17.5h70M.5 0v17M35.5 17v17" stroke="#2a140a" stroke-width="3" />
          </pattern>
          <radialGradient id={id('box')} cx="0.5" cy="0.9" r="0.8">
            <stop offset="0" stop-color="#ff9a3c" />
            <stop offset="0.45" stop-color="#7a2a10" />
            <stop offset="1" stop-color="#1a0a05" />
          </radialGradient>
          <radialGradient id={id('coal')} cx="0.5" cy="0.4" r="0.7">
            <stop offset="0" stop-color="#ffe08a" />
            <stop offset="0.4" stop-color="#ff7a26" />
            <stop offset="1" stop-color="#6a1a08" />
          </radialGradient>
          <radialGradient id={id('heat')}>
            <stop offset="0" stop-color="#ff9a3c" stop-opacity="0.45" />
            <stop offset="1" stop-color="#ff9a3c" stop-opacity="0" />
          </radialGradient>
        </defs>
        <ellipse cx="800" cy="700" rx="560" ry="340" fill={url('heat')} />
        <!-- hearth -->
        <rect x="420" y="540" width="760" height="460" fill={url('brick')} />
        <rect x="408" y="528" width="784" height="22" fill="#3d2a1e" />
        <path d="M500 820V600q300-50 600 0v220z" fill={url('box')} />
        <ellipse cx="800" cy="800" rx="290" ry="30" fill={url('coal')} />
        {[560, 620, 690, 760, 830, 900, 970, 1030].map((x, i) => (
          <ellipse cx={x} cy={800 + (i % 2) * 6} rx="34" ry="14" fill={i % 3 ? '#ffb14a' : '#ff7a26'} opacity="0.9" />
        ))}
      </svg>
      {flames.map((f, i) => (
        <div class="lb-at lb-flame lb-fx" style={`--x:${f.x};--y:${800 - f.h};--w:${f.w};--h:${f.h};--t:${f.t}s;--d:${f.d}s`}>
          <svg viewBox="0 0 100 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id={id(`fl${i}`)} x1="0" y1="1" x2="0" y2="0">
                <stop offset="0" stop-color="#fff2b8" />
                <stop offset="0.3" stop-color="#ffb84a" />
                <stop offset="0.7" stop-color="#f06a1e" stop-opacity="0.85" />
                <stop offset="1" stop-color="#c43a10" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path d="M50 200C16 200 2 170 10 138c8-34 34-46 30-100 22 30 28 56 24 78 12-12 16-28 14-48 18 28 22 60 16 86-6 32-26 46-44 46z" fill={url(`fl${i}`)} />
            <path d="M50 200c-16 0-24-14-20-30 4-16 16-22 16-44 12 16 18 30 16 46 6-6 8-12 8-20 8 14 8 28 2 36-4 8-12 12-22 12z" fill="#ffe08a" opacity="0.55" />
          </svg>
        </div>
      ))}
      <svg class="lb-svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <!-- grill grate + food -->
        <rect x="500" y="736" width="600" height="8" fill="#1a110c" />
        <g stroke="#1a110c" stroke-width="5">
          {Array.from({ length: 20 }, (_, i) => <path d={`M${515 + i * 30} 744v34`} />)}
        </g>
        <rect x="500" y="776" width="600" height="6" fill="#1a110c" />
        <g transform="translate(600 712)">
          <path d="M0 26C0 6 26-2 70 0c44 2 60 12 56 30-4 14-50 18-82 16C10 44 0 38 0 26z" fill="#6a2a12" />
          <path d="M20 10l20 28M50 6l20 32M80 8l18 28" stroke="#2a0e06" stroke-width="5" />
          <path d="M6 22c20-8 60-14 116-4" stroke="#e8a060" stroke-width="3" fill="none" opacity="0.6" />
        </g>
        <g transform="translate(770 706)">
          <path d="M0 22C30-6 110-8 150 18l30-16v40l-30-14C110 54 30 52 0 22z" fill="#8a7a64" />
          <path d="M40 10v26M70 6v32M100 8v30" stroke="#3a2a1a" stroke-width="4" />
          <circle cx="22" cy="20" r="4" fill="#120a06" />
        </g>
        <g transform="translate(980 714)">
          <path d="M0 18C0 4 20 0 34 8c14-8 34-4 34 10 0 16-20 20-34 12C20 38 0 32 0 18z" fill="#9a2a14" />
          <path d="M30 6c2-8 8-12 14-12" stroke="#3b5a2c" stroke-width="4" fill="none" />
        </g>
      </svg>
      {smokes.map((s) => (
        <div class="lb-at lb-smoke lb-fx" style={`--x:${s.x};--y:${s.y};--w:220;--h:220;--t:${s.t}s;--d:${s.d}s;--dx:${s.dx}`}></div>
      ))}
      {embers.map((e) => (
        <div class="lb-at lb-ember lb-fx" style={`--x:${e.x};--y:${e.y};--w:6;--h:6;--t:${e.t}s;--d:${e.d}s;--dx:${e.dx}`}></div>
      ))}
    </div>

    <div class="lb-layer lb-layer--front">
      <svg class="lb-svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id={id('board')} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8a5a30" />
            <stop offset="1" stop-color="#3a2210" />
          </linearGradient>
        </defs>
        <g transform="translate(0 -40)">
        <rect x="0" y="880" width="1600" height="16" fill="#6a6058" />
        <rect x="0" y="880" width="1600" height="4" fill="#d8cfc6" opacity="0.5" />
        <rect x="0" y="896" width="1600" height="160" fill="#0c0806" />
        <path d="M560 930l20-34h440l20 34z" fill={url('board')} />
        <rect x="560" y="930" width="480" height="18" fill="#2a160a" />
        <!-- cleaver -->
        <g transform="translate(640 868) rotate(-6)">
          <rect x="0" y="0" width="110" height="46" rx="4" fill="#b8b4ae" />
          <rect x="0" y="0" width="110" height="8" fill="#e8e4de" />
          <rect x="110" y="14" width="70" height="16" rx="6" fill="#2a160a" />
        </g>
        <!-- rosemary -->
        <g stroke="#3b5a2c" stroke-width="3" fill="none">
          <path d="M820 900c40-6 80-16 120-30" />
          {[0, 1, 2, 3, 4, 5, 6].map((i) => <path d={`M${830 + i * 16} ${898 - i * 4}l8-12M${834 + i * 16} ${898 - i * 4}l10 6`} />)}
        </g>
        <!-- lemons + salt -->
        <g transform="translate(960 896)">
          <ellipse cx="0" cy="0" rx="26" ry="16" fill="#e8c84a" /><ellipse cx="0" cy="-2" rx="20" ry="11" fill="#fbe98a" />
          <ellipse cx="44" cy="4" rx="24" ry="14" fill="#d9b83a" />
        </g>
        <g transform="translate(470 900)">
          <path d="M-34 0h68l-10 26h-48z" fill="#d8cfc6" /><ellipse cx="0" cy="0" rx="34" ry="8" fill="#f4efe8" />
        </g>
              </g>
      </svg>
    </div>
  </div>
</div>
