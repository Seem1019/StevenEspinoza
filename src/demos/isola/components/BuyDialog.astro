---
/**
 * In-page purchase drawer. URL state ?buy=1 (openUi -> Back closes, deep-linkable).
 * Simulated reservation only: no payment or personal fields.
 */
import { useT, type Lang } from '../../../i18n';
import { finishes, type FinishId } from '../data';

interface Props { lang: Lang; money: (n: number) => string }
const { lang, money } = Astro.props;
const t = useT(lang, 'isola');
const names = t.raw<Record<FinishId, string>>('finish.options');
---

<dialog id="isola-buy" class="buy" aria-labelledby="buy-title">
  <div class="buy__panel">
    <header class="buy__head">
      <h2 id="buy-title">{t('buy.title')}</h2>
      <button type="button" class="buy__close" data-close aria-label={t('buy.close')}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </header>

    <form class="buy__form" data-buy-form>
      <fieldset class="buy__field">
        <legend>{t('buy.finish')}</legend>
        <div class="buy__finishes">
          {finishes.map((f, i) => (
            <div class="swatch">
              <input type="radio" name="buy-finish" id={`buy-f-${f.id}`} value={f.id} data-finish-input checked={i === 0} />
              <label for={`buy-f-${f.id}`}>
                <span class="swatch__dot" style={`--dot:${f.shell}`} aria-hidden="true"></span>
                <span class="buy__fname">{names[f.id]}</span>
                <span class="buy__fprice">{money(f.price)}</span>
              </label>
            </div>
          ))}
        </div>
      </fieldset>

      <div class="buy__qty">
        <span id="buy-qty-label">{t('buy.qty')}</span>
        <div class="stepper" role="group" aria-labelledby="buy-qty-label">
          <button type="button" data-qty="-1" aria-label={t('buy.dec')}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 12h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </button>
          <output data-qty-value aria-labelledby="buy-qty-label">1</output>
          <button type="button" data-qty="1" aria-label={t('buy.inc')}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 12h12M12 6v12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </button>
        </div>
      </div>

      <dl class="buy__sum">
        <div><dt>{t('buy.unit')}</dt><dd data-sum-unit>{money(finishes[0].price)}</dd></div>
        <div><dt>{t('buy.shipping')}</dt><dd>{t('buy.shippingValue')}</dd></div>
        <div class="buy__total"><dt>{t('buy.total')}</dt><dd data-sum-total>{money(finishes[0].price)}</dd></div>
      </dl>

      <button type="submit" class="i-btn i-btn--primary buy__submit">{t('buy.submit')}</button>
      <p class="buy__note">{t('buy.note')}</p>
    </form>

    <div class="buy__done" data-buy-done hidden>
      <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true"><circle cx="24" cy="24" r="22" fill="none" stroke="var(--accent)" stroke-width="1.5" /><path d="M15 24.5l6 6 12-13" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <h3 tabindex="-1" data-done-title>{t('buy.successTitle')}</h3>
      <p data-done-text></p>
      <p class="buy__note">{t('buy.note')}</p>
      <button type="button" class="i-btn i-btn--ghost" data-close>{t('buy.done')}</button>
    </div>
    <p class="sr-only" aria-live="polite" data-buy-live></p>
  </div>
  <template data-buy-strings data-success={t('buy.successBody')} data-live={t('buy.live')}></template>
</dialog>

<script>
  import { onPage } from '../../../scripts/lifecycle';
  import { onUrlState, openUi, closeUi, adoptDeepLink } from '../../../scripts/url-state';
  import { getFinish, maxQty } from '../data';
  import { FINISH_EVENT, applyFinish, currentFinish, i18n, money } from '../scripts/finish';

  onPage(() => {
    const dlg = document.getElementById('isola-buy') as HTMLDialogElement | null;
    if (!dlg) return;
    const ac = new AbortController();
    const signal = ac.signal;
    const $ = <T extends Element>(s: string) => dlg.querySelector<T>(s)!;
    const form = $<HTMLFormElement>('[data-buy-form]');
    const done = $<HTMLElement>('[data-buy-done]');
    const qtyEl = $<HTMLOutputElement>('[data-qty-value]');
    const unitEl = $<HTMLElement>('[data-sum-unit]');
    const totalEl = $<HTMLElement>('[data-sum-total]');
    const live = $<HTMLElement>('[data-buy-live]');
    const strings = $<HTMLTemplateElement>('[data-buy-strings]').dataset;
    let qty = 1;
    let opener: HTMLElement | null = null;

    const render = () => {
      const f = getFinish(currentFinish());
      qtyEl.value = String(qty);
      unitEl.textContent = money(f.price);
      totalEl.textContent = money(f.price * qty);
      dlg.querySelectorAll<HTMLButtonElement>('[data-qty]').forEach((b) => {
        const d = Number(b.dataset.qty);
        b.disabled = d < 0 ? qty <= 1 : qty >= maxQty;
      });
    };
    const reset = () => { form.hidden = false; done.hidden = true; live.textContent = ''; };

    const sync = (url: URL) => {
      const want = url.searchParams.has('buy');
      if (want && !dlg.open) { reset(); render(); dlg.showModal(); }
      else if (!want && dlg.open) dlg.close();
    };

    document.addEventListener('click', (e) => {
      const trigger = (e.target as Element | null)?.closest<HTMLElement>('[data-isola-buy]');
      if (!trigger) return;
      opener = trigger;
      openUi({ buy: '1' });
      sync(new URL(location.href));
    }, { signal });

    dlg.addEventListener('close', () => {
      if (new URL(location.href).searchParams.has('buy')) closeUi({ buy: null });
      opener?.focus();
    }, { signal });
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) { dlg.close(); return; }
      const el = e.target as Element;
      if (el.closest('[data-close]')) dlg.close();
      const step = el.closest<HTMLButtonElement>('[data-qty]');
      if (step) {
        qty = Math.min(maxQty, Math.max(1, qty + Number(step.dataset.qty)));
        render();
        live.textContent = (strings.live ?? '').replace('{qty}', String(qty)).replace('{total}', totalEl.textContent ?? '');
      }
    }, { signal });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = i18n().names[currentFinish()];
      $<HTMLElement>('[data-done-text]').textContent = (strings.success ?? '').replace('{qty}', String(qty)).replace('{finish}', name);
      form.hidden = true;
      done.hidden = false;
      requestAnimationFrame(() => $<HTMLElement>('[data-done-title]').focus());
    }, { signal });

    dlg.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.matches('[data-finish-input]')) applyFinish(input.value as never);
    }, { signal });
    document.addEventListener(FINISH_EVENT, render, { signal });

    const off = onUrlState(sync);
    adoptDeepLink(['buy']);
    sync(new URL(location.href));
    return () => { ac.abort(); off(); if (dlg.open) dlg.close(); };
  });
</script>

<style>
  .buy {
    margin: 0 0 0 auto; width: min(460px, 100vw); height: 100dvh; max-height: 100dvh;
    background: var(--bg); color: var(--text); font-family: var(--font);
    border-left: 1px solid var(--line); box-shadow: -24px 0 64px rgb(22 25 29 / 0.12);
  }
  .buy::backdrop { background: rgb(22 25 29 / 0.32); }
  .buy[open] { animation: buy-in 420ms var(--ease); }
  @keyframes buy-in { from { transform: translateX(40px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .buy[open] { animation: none; } }

  .buy__panel { padding: 24px clamp(20px, 4vw, 36px) 32px; display: grid; gap: 28px; }
  .buy__head { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .buy__head h2 { font-weight: 300; font-size: 1.75rem; letter-spacing: -0.025em; }
  .buy__close { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 4px; background: transparent; }
  .buy__close:hover { background: var(--steel-1); }

  .buy__form { display: grid; gap: 28px; }
  .buy__form[hidden], .buy__done[hidden] { display: none; }
  .buy__field { border: 0; margin: 0; padding: 0; display: grid; gap: 12px; }
  .buy__field legend, .buy__qty > span { font-size: 0.8125rem; font-weight: 600; color: var(--muted); margin-bottom: 12px; padding: 0; }
  .buy__finishes { display: grid; gap: 8px; }
  .buy__finishes :global(.swatch label) { display: flex; width: 100%; min-height: 56px; }
  .buy__fname { flex: 1; }
  .buy__fprice { color: var(--muted); font-variant-numeric: tabular-nums; }

  .buy__qty { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .buy__qty > span { margin: 0; }
  .stepper { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 4px; }
  .stepper button { width: 44px; height: 44px; display: grid; place-items: center; background: transparent; border: 0; }
  .stepper button:hover:not(:disabled) { background: var(--steel-1); }
  .stepper button:disabled { color: var(--steel-3); cursor: not-allowed; }
  .stepper output { min-width: 40px; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }

  .buy__sum { margin: 0; display: grid; border-top: 1px solid var(--line); }
  .buy__sum div { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 0.9375rem; }
  .buy__sum dt { color: var(--muted); }
  .buy__sum dd { margin: 0; font-variant-numeric: tabular-nums; }
  .buy__total dt, .buy__total dd { color: var(--text); font-weight: 600; font-size: 1.0625rem; }
  .buy__submit { width: 100%; min-height: 52px; }
  .buy__note { color: var(--muted); font-size: 0.8125rem; text-align: center; margin-top: -12px; }

  .buy__done { display: grid; gap: 16px; justify-items: start; padding-top: 24px; }
  .buy__done h3 { font-weight: 300; font-size: 2rem; letter-spacing: -0.03em; }
  .buy__done h3:focus { outline: none; }
  .buy__done p { color: var(--muted); }
  .buy__done .buy__note { margin: 0; text-align: left; }

  @media (max-width: 599px) {
    .buy { margin: auto 0 0; width: 100%; height: auto; max-height: 92dvh; border-left: 0; border-top: 1px solid var(--line); border-radius: 4px 4px 0 0; box-shadow: 0 -16px 48px rgb(22 25 29 / 0.14); }
    @keyframes buy-up { from { transform: translateY(40px); opacity: 0; } }
    .buy[open] { animation-name: buy-up; }
    .buy__panel { gap: 20px; padding-bottom: 24px; }
    .buy__form { gap: 22px; }
  }
</style>
