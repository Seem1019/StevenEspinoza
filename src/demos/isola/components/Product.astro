---
/**
 * Static product render (inline SVG, 0 requests). Colours come from --shell / --plate / --cushion / --metal / --mark
 * set by [data-finish] on an ancestor, so changing the finish recolours it with CSS only.
 * Shading is done with fixed white/black alpha gradients on top of the base fills.
 * `uid` keeps gradient ids unique when the render appears several times on one page.
 */
interface Props { uid: string; label: string; class?: string }
const { uid, label, class: cls } = Astro.props;
const id = (s: string) => `${uid}-${s}`;
const url = (s: string) => `url(#${id(s)})`;
---

<svg class:list={['isola-product', cls]} viewBox="0 0 640 560" role="img" aria-label={label} preserveAspectRatio="xMidYMid meet">
  <defs>
    <radialGradient id={id('hi')} cx="0.34" cy="0.26" r="0.8">
      <stop offset="0" stop-color="#fff" stop-opacity="0.34" />
      <stop offset="0.45" stop-color="#fff" stop-opacity="0.04" />
      <stop offset="1" stop-color="#000" stop-opacity="0.32" />
    </radialGradient>
    <linearGradient id={id('plate')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.22" />
      <stop offset="0.55" stop-color="#fff" stop-opacity="0" />
      <stop offset="1" stop-color="#000" stop-opacity="0.22" />
    </linearGradient>
    <linearGradient id={id('band')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.28" />
      <stop offset="0.6" stop-color="#fff" stop-opacity="0" />
      <stop offset="1" stop-color="#000" stop-opacity="0.2" />
    </linearGradient>
    <linearGradient id={id('metal')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0.5" />
      <stop offset="0.5" stop-color="#000" stop-opacity="0.08" />
      <stop offset="1" stop-color="#fff" stop-opacity="0.35" />
    </linearGradient>
    <radialGradient id={id('cush')} cx="0.7" cy="0.4" r="0.7">
      <stop offset="0" stop-color="#fff" stop-opacity="0.16" />
      <stop offset="1" stop-color="#000" stop-opacity="0.3" />
    </radialGradient>
    <radialGradient id={id('shadow')} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#1b2026" stop-opacity="0.28" />
      <stop offset="1" stop-color="#1b2026" stop-opacity="0" />
    </radialGradient>
  </defs>

  <ellipse cx="338" cy="532" rx="236" ry="16" fill={url('shadow')} />

  <!-- far yoke + far cup (inner side visible: cushion) -->
  <path d="M352 352 A 102 150 0 0 1 556 352" fill="none" stroke="var(--metal)" stroke-width="7" stroke-linecap="round" />
  <g transform="rotate(-6 452 356)">
    <ellipse cx="452" cy="356" rx="98" ry="132" fill="var(--shell)" />
    <ellipse cx="452" cy="356" rx="98" ry="132" fill={url('hi')} opacity="0.8" />
    <ellipse cx="440" cy="358" rx="80" ry="112" fill="var(--cushion)" />
    <ellipse cx="440" cy="358" rx="80" ry="112" fill={url('cush')} />
    <ellipse cx="436" cy="360" rx="50" ry="78" fill="#121417" opacity="0.72" />
    <ellipse cx="436" cy="360" rx="50" ry="78" fill="none" stroke="#fff" stroke-opacity="0.08" stroke-width="2" />
  </g>

  <!-- headband: inner pad, outer band, highlight -->
  <path d="M262 186 C 252 70, 350 34, 410 40 C 470 46, 476 120, 456 214" fill="none" stroke="var(--cushion)" stroke-width="24" stroke-linecap="round" />
  <path d="M254 176 C 244 48, 356 14, 414 22 C 486 32, 488 112, 462 206" fill="none" stroke="var(--shell)" stroke-width="22" stroke-linecap="round" />
  <path d="M254 176 C 244 48, 356 14, 414 22 C 486 32, 488 112, 462 206" fill="none" stroke={url('band')} stroke-width="22" stroke-linecap="round" />
  <path d="M250 150 C 246 56, 352 22, 412 28" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="2" stroke-linecap="round" />

  <!-- sliders -->
  <rect x="249" y="170" width="7" height="44" rx="3.5" fill="var(--metal)" />
  <rect x="249" y="170" width="7" height="44" rx="3.5" fill={url('metal')} />
  <rect x="456" y="200" width="6" height="22" rx="3" fill="var(--metal)" />

  <!-- near cup: cushion edge (behind), yoke, shell, plate -->
  <ellipse cx="282" cy="376" rx="124" ry="162" fill="var(--cushion)" />
  <ellipse cx="282" cy="376" rx="124" ry="162" fill={url('cush')} />
  <path d="M104 378 A 148 172 0 0 1 400 378" fill="none" stroke="var(--metal)" stroke-width="8" stroke-linecap="round" />
  <path d="M104 378 A 148 172 0 0 1 400 378" fill="none" stroke={url('metal')} stroke-width="8" stroke-linecap="round" />
  <circle cx="104" cy="380" r="9" fill="var(--metal)" />
  <circle cx="400" cy="380" r="9" fill="var(--metal)" />
  <ellipse cx="252" cy="374" rx="130" ry="168" fill="var(--shell)" />
  <ellipse cx="252" cy="374" rx="130" ry="168" fill={url('hi')} />
  <ellipse cx="246" cy="370" rx="108" ry="142" fill="none" stroke="var(--metal)" stroke-width="2.5" opacity="0.9" />
  <ellipse cx="246" cy="370" rx="104" ry="138" fill="var(--plate)" />
  <ellipse cx="246" cy="370" rx="104" ry="138" fill={url('plate')} />
  <text x="246" y="376" text-anchor="middle" font-family="var(--font-isola), system-ui, sans-serif" font-size="19" font-weight="300" letter-spacing="3" fill="var(--mark)">isola</text>
  <circle cx="318" cy="252" r="3" fill="#000" opacity="0.35" />
  <circle cx="330" cy="268" r="3" fill="#000" opacity="0.35" />
  <rect x="377" y="420" width="5" height="26" rx="2.5" fill="var(--metal)" opacity="0.9" />
</svg>

<style>
  .isola-product { width: 100%; height: 100%; }
</style>
