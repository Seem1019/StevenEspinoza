---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import DemoThumb from '../../components/site/DemoThumb.astro';
import { useT, langPaths, localePath, type Lang } from '../../i18n';
import { demos } from '../../data/demos';
import { profile } from '../../data/profile';
import AgentFlow from '../../components/site/AgentFlow.astro';
import homeScene from '../../showcase/scenes/home';
import { resolveScene, agentLabels } from '../../showcase/resolve';
import '../../styles/build-states.css';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang, 'home');
const c = useT(lang, 'common');
const metrics = t.raw<{ value: string; label: string }[]>('hero.metrics');
const pillars = t.raw<{ title: string; body: string }[]>('pillars.items');
const introData = { scene: resolveScene(homeScene, lang), labels: agentLabels(lang) };
const cards = demos.map((d) => {
  const dt = useT(lang, d.ns);
  return { ...d, name: dt('meta.name'), tagline: dt('meta.tagline'), description: dt('meta.description'), features: dt.raw<string[]>('meta.features') };
});
---

<BaseLayout lang={lang} title={t('meta.title')} description={t('meta.description')}>
  {/*
    Intro gate decision BEFORE first paint (classic inline script, no flash). No gate for reduced motion,
    crawlers, deep links (?demo=, #hash) or a second visit in this session. Watchdog: if the intro module
    never runs, the plain home appears after 4 s. Content is always in this HTML; the intro only reveals it.
  */}
  <script is:inline slot="head">
    (function () {
      try {
        var d = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (/bot|crawl|spider|slurp|facebookexternalhit|embedly/i.test(navigator.userAgent)) return;
        if (location.search.indexOf('demo=') > -1 || location.hash) return;
        try { if (sessionStorage.getItem('se-intro')) return; } catch (e) {}
        d.setAttribute('data-intro', 'gate');
        setTimeout(function () { if (!window.__introReady && d.getAttribute('data-intro') === 'gate') d.removeAttribute('data-intro'); }, 4000);
      } catch (e) {}
    })();
  </script>
  <SiteHeader lang={lang} current="home" build="h-header" />
  <main id="main">
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <h1 class="hero__title" data-build="h-title">{t('hero.title')}</h1>
          <p class="hero__lead" data-build="h-lead">{t('hero.lead')}</p>
          <div class="hero__ctas" data-build="h-ctas">
            <a class="btn btn--primary" href="#demos">{t('hero.ctaDemos')}</a>
            <a class="btn btn--ghost" href={localePath(lang, 'showcase/')} data-astro-prefetch="viewport">{t('hero.ctaShowcase')}</a>
          </div>
        </div>
        <ul class="hero__stack" role="list" aria-label={t('gallery.title')}>
          {
            cards.map((d, i) => (
              <li data-build={`h-card${i + 1}`} style={`--bg:${d.card.bg};--fg:${d.card.fg};--ac:${d.card.accent};--i:${i}`}>
                <a href={localePath(lang, `demos/${d.slug}/`)} data-astro-prefetch="viewport">
                  <span class="hero__stack-sector">{c(`sectors.${d.sector}`)}</span>
                  <span class="hero__stack-name">{d.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="wrap">
        <dl class="hero__metrics" data-build="h-metrics">
          {metrics.map((m) => (<div><dt>{m.label}</dt><dd>{m.value}</dd></div>))}
        </dl>
      </div>
    </section>

    <section id="demos" class="home-below gallery" aria-labelledby="gallery-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="gallery-title">{t('gallery.title')}</h2>
          <p>{t('gallery.lead')}</p>
        </div>
        <ul class="gallery__grid" role="list">
          {
            cards.map((d) => (
              <li class="card" style={`--bg:${d.card.bg};--fg:${d.card.fg};--ac:${d.card.accent}`}>
                <DemoThumb slug={d.slug} lang={lang} bg={d.card.bg} />
                <div class="card__body">
                  <p class="card__sector">{c(`sectors.${d.sector}`)}</p>
                  <h3 class="card__name">{d.name}</h3>
                  <p class="card__tagline">{d.tagline}</p>
                  <div class="card__actions">
                    <a class="btn btn--primary" href={localePath(lang, `demos/${d.slug}/`)} data-astro-prefetch="viewport">{t('gallery.open')}</a>
                    <button type="button" class="btn btn--ghost" data-demo-open={d.slug}>{t('gallery.details')}</button>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="home-below pillars" aria-labelledby="pillars-title">
      <div class="wrap">
        <h2 id="pillars-title" class="pillars__title">{t('pillars.title')}</h2>
        <ul class="pillars__grid" role="list">
          {pillars.map((p) => (<li><h3>{p.title}</h3><p>{p.body}</p></li>))}
        </ul>
      </div>
    </section>

    <section class="home-below teaser" aria-labelledby="teaser-title">
      <div class="wrap teaser__inner">
        <div>
          <h2 id="teaser-title">{t('showcase.title')}</h2>
          <p>{t('showcase.body')}</p>
        </div>
        <a class="btn btn--primary" href={localePath(lang, 'showcase/')} data-astro-prefetch="viewport">{t('showcase.cta')}</a>
      </div>
    </section>

    <section class="home-below final-cta" aria-labelledby="cta-title">
      <div class="wrap final-cta__inner">
        <h2 id="cta-title">{t('cta.title')}</h2>
        <p>{t('cta.body')}</p>
        <div class="hero__ctas">
          <button type="button" class="btn btn--primary" data-open-contact>{t('cta.contact')}</button>
          <a class="btn btn--ghost" href={profile.whatsapp} target="_blank" rel="noopener noreferrer">{t('cta.whatsapp')}</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} />

  <div class="ag-gate" data-intro-gate>
    <div class="ag-gate__inner">
      <p class="ag-gate__caption">{t('intro.gate.caption')}</p>
      <button type="button" class="ag-gate__start" data-intro-start><span class="ag-gate__bg" aria-hidden="true"></span><span class="ag-gate__label">{t('intro.gate.start')}</span></button>
      <button type="button" class="ag-gate__skip" data-intro-skip>{t('intro.gate.skip')}</button>
    </div>
  </div>
  <AgentFlow lang={lang} variant="float" id="intro-flow" hidden>
    <button type="button" class="ag-flow__btn" data-intro-panel-skip>{t('intro.skip')}</button>
  </AgentFlow>
  <button type="button" class="ag-replay" data-intro-replay hidden>
    <span class="ag-replay__marks" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{t('intro.replay')}
  </button>
  <script type="application/json" id="intro-data" set:html={JSON.stringify(introData)} />

  <dialog id="demo-dialog" class="demo-dialog" aria-label={t('gallery.title')}>
    {
      cards.map((d) => (
        <article class="demo-dialog__item" data-demo-detail={d.slug} hidden style={`--bg:${d.card.bg};--fg:${d.card.fg};--ac:${d.card.accent}`}>
          <header class="demo-dialog__head">
            <div>
              <p class="card__sector">{c(`sectors.${d.sector}`)}</p>
              <h2>{d.name}</h2>
            </div>
            <button type="button" class="demo-dialog__close" data-demo-close aria-label={t('gallery.close')}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </button>
          </header>
          <p class="demo-dialog__desc">{d.description}</p>
          <h3 class="demo-dialog__sub">{t('gallery.includes')}</h3>
          <ul class="demo-dialog__list" role="list">
            {d.features.map((f) => <li>{f}</li>)}
            {d.techniques.map((k) => <li>{c(`techniques.${k}`)}</li>)}
          </ul>
          <div class="card__actions">
            <a class="btn btn--primary" href={localePath(lang, `demos/${d.slug}/`)}>{t('gallery.open')}</a>
            <a class="btn btn--ghost" href={localePath(lang, `showcase/?demo=${d.slug}`)}>{t('gallery.watch')}</a>
          </div>
        </article>
      ))
    }
  </dialog>
</BaseLayout>

<script>
  import { onPage } from '../../scripts/lifecycle';
  import { onUrlState, openUi, closeUi, adoptDeepLink } from '../../scripts/url-state';
  import { mountIntro } from '../../showcase/intro';

  onPage(mountIntro);

  onPage(() => {
    const dlg = document.getElementById('demo-dialog') as HTMLDialogElement | null;
    if (!dlg) return;
    const ac = new AbortController();
    const signal = ac.signal;
    const items = [...dlg.querySelectorAll<HTMLElement>('[data-demo-detail]')];

    const sync = (url: URL) => {
      const slug = url.searchParams.get('demo');
      const item = items.find((i) => i.dataset.demoDetail === slug);
      if (item) {
        items.forEach((i) => (i.hidden = i !== item));
        dlg.setAttribute('aria-label', item.querySelector('h2')?.textContent ?? '');
        if (!dlg.open) dlg.showModal();
      } else if (dlg.open) dlg.close();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-demo-open]').forEach((b) =>
      b.addEventListener('click', () => { openUi({ demo: b.dataset.demoOpen }); sync(new URL(location.href)); }, { signal }),
    );
    dlg.addEventListener('close', () => { if (new URL(location.href).searchParams.has('demo')) closeUi({ demo: null }); }, { signal });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }, { signal });
    dlg.querySelectorAll('[data-demo-close]').forEach((b) => b.addEventListener('click', () => dlg.close(), { signal }));

    const off = onUrlState(sync);
    adoptDeepLink(['demo']);
    sync(new URL(location.href));
    return () => { ac.abort(); off(); };
  });
</script>

<style is:global>
  /* Home intro (see src/showcase/intro.ts). Without html[data-intro] nothing here applies. */
  html[data-intro='gate'] { overflow: hidden; }
  /* deliberate errors (oversized headline, cards in a pile) must never create a horizontal scroll */
  html[data-intro] body { overflow-x: clip; }
  html[data-intro='gate'] :is(.site-header, #main, .site-footer) { visibility: hidden; }
  html[data-intro] :is(.home-below, .site-footer) { opacity: 0; }
  .home-below, .site-footer { transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1); }
  html[data-intro] .hero__metrics dd { font-variant-numeric: tabular-nums; }
  html[data-intro] .hero__stack li { position: relative; }
  html[data-intro] .hero__stack li:nth-child(4) { z-index: 4; }
  html[data-intro] .hero__stack li:nth-child(3) { z-index: 3; }
  html[data-intro] .hero__stack li:nth-child(2) { z-index: 2; }

  .ag-gate { display: none; }
  html[data-intro='gate'] .ag-gate, .ag-gate.is-morphing { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; padding: 24px; }
  html[data-intro='gate'] .ag-gate:not(.is-morphing) { background: var(--ink); }
  .ag-gate.is-morphing { pointer-events: none; }
  .ag-gate[hidden] { display: none !important; }
  .ag-gate__inner { display: grid; justify-items: center; gap: 22px; max-width: 34ch; text-align: center; }
  .ag-gate__caption { color: var(--muted); font-size: 1rem; }
  .ag-gate__start {
    position: relative; min-width: 220px; min-height: 60px; padding: 0 36px; border: 0; background: none; color: var(--accent-ink);
    font-family: var(--font-display); font-weight: 800; font-size: 1.375rem; letter-spacing: -0.01em;
  }
  .ag-gate__bg { position: absolute; inset: 0; background: var(--accent); border-radius: var(--radius-sm); }
  .ag-gate__start:hover .ag-gate__bg { background: #ff7442; }
  .ag-gate__label { position: relative; }
  .ag-gate__skip { min-height: 44px; padding: 0 12px; background: none; border: 0; color: var(--muted); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .ag-gate__skip:hover { color: var(--text); }

  .ag-replay {
    position: fixed; right: 16px; bottom: 16px; z-index: 65; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px;
    background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: var(--radius-sm); font-weight: 700; font-size: 0.875rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.4); transition: border-color var(--dur-1), transform var(--dur-1) var(--ease-out);
  }
  .ag-replay[hidden] { display: none; }
  .ag-replay:hover { border-color: var(--muted); }
  .ag-replay:active { transform: scale(0.97); }
  .ag-replay__marks { display: grid; grid-template-columns: repeat(2, 6px); gap: 2px; }
  .ag-replay__marks i { width: 6px; height: 6px; border-radius: 1px; background: #ff7a45; }
  .ag-replay__marks i:nth-child(2) { background: #4cc9f0; }
  .ag-replay__marks i:nth-child(3) { background: #ffd166; }
  .ag-replay__marks i:nth-child(4) { background: #3ddc97; }
  @media (max-width: 639px) { .ag-replay { right: 12px; bottom: 12px; } }
</style>

<style>
  .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--gutter); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 20px;
    border-radius: var(--radius-sm); font-weight: 700; text-decoration: none; border: 1px solid transparent; font-size: 1rem;
    transition: transform var(--dur-1) var(--ease-out), background-color var(--dur-1), border-color var(--dur-1);
  }
  .btn:active { transform: scale(0.97); }
  .btn--primary { background: var(--accent); color: var(--accent-ink); }
  .btn--primary:hover { background: #ff7442; }
  .btn--ghost { background: transparent; color: var(--text); border-color: var(--line); }
  .btn--ghost:hover { border-color: var(--text); }

  /* Hero */
  .hero { padding: clamp(40px, 8vw, 96px) 0 40px; }
  .hero__grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.25fr 1fr; } }
  .hero__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.4rem, 6.4vw, 4.6rem); letter-spacing: -0.035em; line-height: 0.98; }
  .hero__lead { margin-top: 24px; max-width: 58ch; color: var(--muted); font-size: clamp(1.0625rem, 1.6vw, 1.25rem); }
  .hero__ctas { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__stack { display: grid; gap: 10px; }
  .hero__stack li { margin-left: calc(var(--i) * 4%); }
  .hero__stack a {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 18px 20px; min-height: 72px;
    background: var(--bg); color: var(--fg); border-radius: var(--radius); text-decoration: none;
    box-shadow: inset 6px 0 0 var(--ac);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .hero__stack a:hover { transform: translateX(-8px); }
  .hero__stack-sector { font-size: 0.8125rem; font-weight: 700; padding: 3px 8px; border-radius: var(--radius-sm); background: rgb(12 13 14 / 0.88); color: #fff; }
  .hero__stack-name { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; letter-spacing: -0.02em; }

  .hero__metrics { margin: 56px 0 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  @media (min-width: 720px) { .hero__metrics { grid-template-columns: repeat(3, 1fr); } }
  .hero__metrics div { background: var(--ink); padding: 18px 20px; display: flex; flex-direction: column-reverse; gap: 4px; }
  .hero__metrics dt { color: var(--muted); font-size: 0.9375rem; }
  .hero__metrics dd { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 1.75rem; letter-spacing: -0.02em; }

  /* Gallery */
  .gallery { padding: clamp(56px, 8vw, 112px) 0; scroll-margin-top: 64px; }
  .section-head { max-width: 680px; margin-bottom: 40px; }
  .section-head h2, .pillars__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(2rem, 4.4vw, 3.2rem); letter-spacing: -0.03em; }
  .section-head p { margin-top: 12px; color: var(--muted); font-size: 1.125rem; }
  .gallery__grid { display: grid; gap: 20px; }
  @media (min-width: 760px) { .gallery__grid { grid-template-columns: 1fr 1fr; } }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
  .card__body { padding: 20px; display: grid; gap: 8px; flex: 1; align-content: start; }
  .card__sector { font-size: 0.875rem; font-weight: 600; color: var(--muted); }
  .card__name { font-family: var(--font-display); font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; }
  .card__tagline { color: var(--muted); }
  .card__actions { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 10px; }

  /* Pillars */
  .pillars { padding: clamp(56px, 8vw, 96px) 0; border-top: 1px solid var(--line); }
  .pillars__grid { margin-top: 36px; display: grid; gap: 28px; }
  @media (min-width: 860px) { .pillars__grid { grid-template-columns: repeat(3, 1fr); } }
  .pillars__grid li { border-top: 3px solid var(--accent); padding-top: 18px; }
  .pillars__grid h3 { font-family: var(--font-display); font-size: 1.375rem; font-weight: 700; letter-spacing: -0.01em; }
  .pillars__grid p { margin-top: 8px; color: var(--muted); }

  /* Teaser */
  .teaser { padding: 0 0 clamp(56px, 8vw, 96px); }
  .teaser__inner {
    display: grid; gap: 24px; align-items: center; padding-top: clamp(28px, 5vw, 48px); padding-bottom: clamp(28px, 5vw, 48px);
    background: var(--accent); color: var(--accent-ink); border-radius: var(--radius-lg);
  }
  @media (min-width: 860px) { .teaser__inner { grid-template-columns: 1fr auto; } }
  .teaser h2 { font-family: var(--font-display); font-size: clamp(1.75rem, 3.6vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; }
  .teaser p { margin-top: 10px; max-width: 60ch; font-size: 1.0625rem; }
  .teaser .btn--primary { background: var(--ink); color: var(--text); }
  .teaser .btn--primary:hover { background: #24282c; }

  .final-cta { padding: clamp(56px, 8vw, 112px) 0; border-top: 1px solid var(--line); }
  .final-cta__inner { text-align: left; }
  .final-cta h2 { font-family: var(--font-display); font-weight: 800; font-size: clamp(2rem, 5vw, 3.6rem); letter-spacing: -0.035em; max-width: 18ch; }
  .final-cta p { margin-top: 14px; color: var(--muted); font-size: 1.125rem; }

  /* Demo details dialog */
  .demo-dialog { width: min(640px, calc(100vw - 24px)); background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .demo-dialog[open] { animation: dd-in var(--dur-2) var(--ease-out); }
  @keyframes dd-in { from { opacity: 0; transform: translateY(16px); } }
  @media (prefers-reduced-motion: reduce) { .demo-dialog[open] { animation: none; } }
  .demo-dialog__item { padding: clamp(18px, 4vw, 32px); border-top: 8px solid var(--bg); }
  .demo-dialog__head { display: flex; justify-content: space-between; gap: 16px; align-items: start; }
  .demo-dialog__head h2 { font-family: var(--font-display); font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; }
  .demo-dialog__close { width: 44px; height: 44px; flex: none; display: grid; place-items: center; background: transparent; border: 1px solid var(--line); border-radius: var(--radius); color: var(--text); }
  .demo-dialog__desc { margin-top: 12px; color: var(--muted); font-size: 1.0625rem; }
  .demo-dialog__sub { margin-top: 24px; font-size: 1rem; font-weight: 700; }
  .demo-dialog__list { margin-top: 10px; display: grid; gap: 8px; }
  .demo-dialog__list li { padding-left: 18px; position: relative; }
  .demo-dialog__list li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 8px; height: 8px; background: var(--accent); border-radius: 2px; }
</style>
