---
/**
 * "Agentes en vivo" — scripted build simulation. Everything needed is in this HTML (previews in
 * <template>, timelines as JSON), so once loaded it works offline. No fetches.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/site/SiteHeader.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import { useT, langPaths, localePath, type Lang } from '../../../i18n';
import { demos } from '../../../data/demos';
import { timelines } from '../../../showcase/registry';
import type { AgentId, ResolvedTimeline } from '../../../showcase/types';
import BrincoPreview from '../../../demos/brinco/BuildPreview.astro';
import LumbrePreview from '../../../demos/lumbre/BuildPreview.astro';
import IsolaPreview from '../../../demos/isola/BuildPreview.astro';
import TurnioPreview from '../../../demos/turnio/BuildPreview.astro';
import '../../../styles/build-states.css';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang, 'showcase');
const c = useT(lang, 'common');

const previews: Record<string, typeof BrincoPreview> = { brinco: BrincoPreview, lumbre: LumbrePreview, isola: IsolaPreview, turnio: TurnioPreview };

const resolved: ResolvedTimeline[] = timelines.map((tl) => {
  const dt = useT(lang, tl.slug);
  return {
    slug: tl.slug,
    duration: tl.duration,
    steps: tl.steps.map(({ log, ...s }) => ({ ...s, text: dt(`showcase.logs.${log}`) })),
  };
});
const choices = demos
  .filter((d) => resolved.some((r) => r.slug === d.slug))
  .map((d) => ({ ...d, name: useT(lang, d.ns)('meta.name'), href: localePath(lang, `demos/${d.slug}/`) }));
const agents: AgentId[] = ['design', 'frontend', 'copy', 'qa'];
const payload = {
  timelines: resolved,
  links: Object.fromEntries(choices.map((ch) => [ch.slug, ch.href])),
  urls: Object.fromEntries(choices.map((ch) => [ch.slug, `${ch.slug}.demo/${lang}`])),
  labels: { idle: t('status.idle'), working: t('status.working'), done: t('status.done') },
};
const first = choices[0];
---

<BaseLayout
  lang={lang}
  title={t('meta.title')}
  description={t('meta.description')}
  fonts={['--font-brand-display', '--font-brand-body', '--font-brinco', '--font-lumbre-display', '--font-lumbre-body', '--font-isola', '--font-turnio']}
  preload={['--font-brand-display']}
>
  <SiteHeader lang={lang} current="showcase" />
  <main id="main" class="sc" data-sc-root data-sc-status="idle">
    <section class="wrap sc-intro">
      <h1>{t('title')}</h1>
      <p class="sc-lead">{t('lead')}</p>
      <div class="sc-pick" role="group" aria-label={t('pick')}>
        <p class="sc-pick__label" aria-hidden="true">{t('pick')}</p>
        <div class="sc-pick__options">
          {
            choices.map((ch, i) => (
              <button type="button" data-sc-pick={ch.slug} aria-pressed={i === 0 ? 'true' : 'false'} style={`--bg:${ch.card.bg};--fg:${ch.card.fg};--ac:${ch.card.accent}`}>
                <span class="sc-pick__swatch" aria-hidden="true" />
                <span class="sc-pick__name">{ch.name}</span>
                <span class="sc-pick__sector">{c(`sectors.${ch.sector}`)}</span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <section class="wrap sc-grid" aria-label={t('stageLabel')}>
      <div class="sc-stage-col">
        <div class="sc-hud">
          <div class="sc-controls">
            <button type="button" class="sc-btn sc-btn--primary" data-sc-activate>{t('activate')}</button>
            <button type="button" class="sc-btn" data-sc-skip disabled>{t('skip')}</button>
            <button type="button" class="sc-btn" data-sc-replay disabled>{t('replay')}</button>
          </div>
          <div class="sc-meter">
            <div class="sc-progress" data-sc-progress role="progressbar" aria-label={t('progress')} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span /></div>
            <dl class="sc-stats">
              <div><dt>{t('time')}</dt><dd data-sc-time>0.0 s</dd></div>
              <div><dt>{t('layers')}</dt><dd data-sc-layers>0</dd></div>
            </dl>
          </div>
        </div>
        <div class="sc-browser">
          <div class="sc-browser__bar" aria-hidden="true">
            <span class="sc-browser__dot" /><span class="sc-browser__dot" /><span class="sc-browser__dot" />
            <span class="sc-browser__url" data-sc-url>{payload.urls[first.slug]}</span>
          </div>
          <div class="sc-viewport" data-sc-stage-viewport tabindex="0" aria-label={t('stageLabel')}>
            <div data-sc-stage-sizer class="sc-sizer">
              <div class="build-stage sc-stage" data-sc-stage></div>
            </div>
            <noscript><p class="sc-empty sc-empty--ns">{t('noscript')}</p></noscript>
          </div>
          <p class="sc-empty">{t('stageEmpty')}</p>
          <div class="sc-done" aria-live="polite">
            <p class="sc-done__title">{t('done.title')}</p>
            <a class="sc-btn sc-btn--primary" data-sc-open href={first.href}>{t('done.open')}</a>
            <button type="button" class="sc-btn sc-btn--dark" data-sc-another>{t('done.another')}</button>
          </div>
        </div>

      </div>

      <div class="sc-agents">
        {
          agents.map((a) => (
            <article class="sc-agent" data-sc-agent={a} data-status="idle">
              <header>
                <span class="sc-agent__mark" aria-hidden="true" />
                <div>
                  <h2>{t(`agents.${a}.name`)}</h2>
                  <p>{t(`agents.${a}.role`)}</p>
                </div>
                <span class="sc-agent__status" data-sc-status>{t('status.idle')}</span>
              </header>
              <ol class="sc-agent__log" data-sc-log aria-live="off" />
            </article>
          ))
        }
      </div>
    </section>

    {
      choices.map((ch) => {
        const Preview = previews[ch.slug];
        return (
          <template data-sc-preview={ch.slug}>
            <Preview lang={lang} />
          </template>
        );
      })
    }
    <script type="application/json" id="sc-data" set:html={JSON.stringify(payload)} />
  </main>
  <p class="sc-badge" role="note">{t('badge')}</p>
  <SiteFooter lang={lang} />
</BaseLayout>

<script>
  import { onPage, prefersReducedMotion } from '../../../scripts/lifecycle';
  import { setParams, getParam } from '../../../scripts/url-state';
  import { BuildEngine, type EngineStatus } from '../../../showcase/engine';
  import type { ResolvedTimeline } from '../../../showcase/types';

  interface Payload {
    timelines: ResolvedTimeline[];
    links: Record<string, string>;
    urls: Record<string, string>;
    labels: { idle: string; working: string; done: string };
  }

  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-sc-root]');
    const dataEl = document.getElementById('sc-data');
    if (!root || !dataEl) return;
    const data = JSON.parse(dataEl.textContent || '{}') as Payload;
    const ac = new AbortController();
    const signal = ac.signal;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const activate = $<HTMLButtonElement>('[data-sc-activate]');
    const skip = $<HTMLButtonElement>('[data-sc-skip]');
    const replay = $<HTMLButtonElement>('[data-sc-replay]');
    const open = $<HTMLAnchorElement>('[data-sc-open]');
    const url = $('[data-sc-url]');
    const progress = $('[data-sc-progress]');
    const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-sc-pick]')];

    const onStatus = (s: EngineStatus) => {
      activate.disabled = s === 'running';
      skip.disabled = s !== 'running';
      replay.disabled = s === 'idle';
      picks.forEach((p) => (p.disabled = s === 'running'));
      progress.setAttribute('aria-valuenow', s === 'done' ? '100' : s === 'idle' ? '0' : progress.getAttribute('aria-valuenow') ?? '0');
      if (s === 'done') open.focus({ preventScroll: true });
    };

    const engine = new BuildEngine(root, data.timelines, { reduced: prefersReducedMotion(), labels: data.labels, onStatus });

    const choose = (slug: string) => {
      if (!data.links[slug]) return;
      engine.load(slug);
      picks.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.scPick === slug)));
      open.href = data.links[slug];
      url.textContent = data.urls[slug];
      setParams({ demo: slug });
    };

    picks.forEach((p) => p.addEventListener('click', () => choose(p.dataset.scPick!), { signal }));
    activate.addEventListener('click', () => engine.play(), { signal });
    skip.addEventListener('click', () => engine.skip(), { signal });
    replay.addEventListener('click', () => engine.replay(), { signal });
    $('[data-sc-another]').addEventListener('click', () => {
      const i = picks.findIndex((p) => p.dataset.scPick === engine.current);
      const next = picks[(i + 1) % picks.length];
      choose(next.dataset.scPick!);
      next.focus();
      engine.play();
    }, { signal });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.dataset.scStatus === 'running') engine.skip();
    }, { signal });

    const initial = getParam('demo');
    choose(initial && data.links[initial] ? initial : picks[0].dataset.scPick!);
    return () => { ac.abort(); engine.destroy(); };
  });
</script>

<style>
  .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--gutter); }
  .sc { padding-bottom: 72px; }
  .sc-intro { padding-top: clamp(28px, 4vw, 48px); padding-bottom: 20px; }
  .sc-intro h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.2rem, 5.6vw, 4rem); letter-spacing: -0.035em; }
  .sc-lead { margin-top: 14px; max-width: 64ch; color: var(--muted); font-size: 1.125rem; }

  .sc-pick { margin-top: 20px; }
  .sc-pick__label { font-weight: 700; margin-bottom: 10px; }
  .sc-pick__options { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  @media (min-width: 860px) { .sc-pick__options { grid-template-columns: repeat(4, 1fr); } }
  .sc-pick button {
    display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 10px; align-items: center; text-align: left;
    min-height: 64px; padding: 10px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); color: var(--text);
    transition: border-color var(--dur-1), transform var(--dur-1) var(--ease-out);
  }
  .sc-pick button:hover:not(:disabled) { border-color: var(--muted); }
  .sc-pick button:active:not(:disabled) { transform: scale(0.98); }
  .sc-pick button[aria-pressed='true'] { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .sc-pick button:disabled { opacity: 0.55; cursor: not-allowed; }
  .sc-pick__swatch { grid-row: 1 / 3; width: 28px; height: 28px; border-radius: var(--radius-sm); background: linear-gradient(135deg, var(--bg) 60%, var(--ac) 60%); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15); }
  .sc-pick__name { font-family: var(--font-display); font-weight: 700; font-size: 1.0625rem; }
  .sc-pick__sector { color: var(--muted); font-size: 0.8125rem; }

  .sc-grid { display: grid; gap: 20px; }
  @media (min-width: 1024px) { .sc-grid { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: start; } }

  .sc-browser { position: relative; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: #fff; }
  .sc-browser__bar { height: 36px; display: flex; align-items: center; gap: 6px; padding: 0 12px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
  .sc-browser__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .sc-browser__url { margin-left: 10px; flex: 1; min-width: 0; height: 22px; display: flex; align-items: center; padding: 0 10px; border-radius: 4px; background: var(--ink); color: var(--muted); font-size: 0.75rem; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .sc-viewport { position: relative; height: clamp(300px, 52svh, 640px); overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; background: #f3f4f6; }
  .sc-sizer { position: relative; overflow: hidden; }
  .sc-stage { position: absolute; top: 0; left: 0; width: 1280px; transform-origin: 0 0; }
  .sc-empty { position: absolute; inset: auto 12px 12px 12px; margin: 0; padding: 10px 14px; background: var(--ink); color: var(--text); border-radius: var(--radius-sm); font-size: 0.9375rem; transition: opacity var(--dur-2); }
  .sc:not([data-sc-status='idle']) .sc-empty { opacity: 0; pointer-events: none; }
  .sc-empty--ns { position: static; margin: 16px; }

  .sc-hud { margin-bottom: 12px; display: grid; gap: 12px; }
  .sc-controls { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 8px; }
  @media (min-width: 640px) { .sc-controls { display: flex; } }
  .sc-btn {
    min-height: 44px; padding: 4px 14px; display: inline-flex; text-align: center; line-height: 1.2; align-items: center; justify-content: center; border-radius: var(--radius-sm);
    border: 1px solid var(--line); background: transparent; color: var(--text); font-weight: 700; text-decoration: none;
    transition: transform var(--dur-1) var(--ease-out), border-color var(--dur-1), opacity var(--dur-1);
  }
  .sc-btn:hover:not(:disabled) { border-color: var(--text); }
  .sc-btn:active:not(:disabled) { transform: scale(0.97); }
  .sc-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .sc-btn--primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .sc-btn--primary:hover:not(:disabled) { border-color: var(--accent); background: #ff7442; }
  .sc-meter { display: grid; grid-template-columns: 1fr auto; gap: 8px 16px; align-items: center; }
  .sc-progress { height: 8px; background: var(--surface-2); border-radius: 2px; overflow: hidden; --p: 0; }
  .sc-progress span { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(var(--p)); }
  .sc-stats { margin: 0; display: flex; gap: 16px; }
  .sc-stats div { display: flex; gap: 6px; font-size: 0.875rem; }
  .sc-stats dt { color: var(--muted); }
  .sc-stats dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 700; min-width: 7ch; }

  .sc-btn--dark { background: var(--ink); color: var(--text); border-color: var(--ink); }
  .sc-done { position: absolute; inset: auto 12px 12px 12px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 12px 14px; background: var(--accent); color: var(--accent-ink); border-radius: var(--radius); box-shadow: 0 10px 30px rgb(0 0 0 / 0.35); visibility: hidden; opacity: 0; transform: translateY(6px); transition: opacity var(--dur-2), transform var(--dur-2) var(--ease-out); }
  .sc[data-sc-status='done'] .sc-done { visibility: visible; opacity: 1; transform: none; }
  .sc-done .sc-btn--primary { background: var(--text); color: var(--ink); border-color: var(--text); }
  .sc-done__title { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; margin-right: auto; }

  .sc-agents { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 1024px) { .sc-agents { grid-template-columns: 1fr; } }
  .sc-agent { --c: #ff7a45; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px; min-width: 0; transition: border-color var(--dur-2), opacity var(--dur-2), transform var(--dur-2) var(--ease-out); }
  .sc-agent[data-sc-agent='frontend'] { --c: #4cc9f0; }
  .sc-agent[data-sc-agent='copy'] { --c: #ffd166; }
  .sc-agent[data-sc-agent='qa'] { --c: #3ddc97; }
  .sc[data-sc-status='idle'] .sc-agent { transform: translateY(4px); border-style: dashed; }
  .sc-agent[data-status='working'] { border-color: var(--c); }
  .sc-agent header { display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; align-items: center; }
  .sc-agent__mark { grid-row: 1 / 3; width: 12px; height: 12px; border-radius: 2px; background: var(--c); }
  .sc-agent[data-status='working'] .sc-agent__mark { animation: sc-blink 900ms steps(2) infinite; }
  .sc-agent h2 { font-family: var(--font-display); font-size: 1rem; font-weight: 700; }
  .sc-agent header p { grid-column: 2; color: var(--muted); font-size: 0.75rem; line-height: 1.3; }
  .sc-agent__status { grid-column: 1 / -1; justify-self: start; margin-top: 6px; font-size: 0.75rem; font-weight: 700; color: var(--c); }
  .sc-agent__log { list-style: none; margin: 10px 0 0; padding: 8px 0 0; border-top: 1px solid var(--line); height: 7.6em; overflow-y: auto; font-size: 0.75rem; line-height: 1.5; color: var(--muted); }
  @media (min-width: 1024px) { .sc-agent__log { height: 6.2em; } }
  .sc-agent__log :global(li) { overflow-wrap: anywhere; }
  .sc-agent__log :global(li:last-child) { color: var(--text); }
  @keyframes sc-blink { 50% { opacity: 0.3; } }
  @media (prefers-reduced-motion: reduce) { .sc-agent[data-status='working'] .sc-agent__mark { animation: none; } }

  .sc-badge {
    position: fixed; left: 12px; bottom: 12px; z-index: 40; padding: 6px 10px; border-radius: var(--radius-sm);
    background: var(--ink); color: var(--muted); border: 1px solid var(--line); font-size: 0.75rem; font-weight: 600; pointer-events: none;
  }
</style>
