---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useT, localePath } from '../i18n';
const t = useT('es');
const te = useT('en');
---

<BaseLayout lang="es" title={`404 · ${t('notFound.title')}`} description={t('notFound.body')} contact={false}>
  <main id="main" class="nf">
    <p class="nf__code">404</p>
    <h1>{t('notFound.title')} / <span lang="en">{te('notFound.title')}</span></h1>
    <p>{t('notFound.body')}</p>
    <p class="nf__links">
      <a href={localePath('es')}>{t('notFound.cta')}</a>
      <a href={localePath('en')} lang="en">{te('notFound.cta')}</a>
    </p>
  </main>
</BaseLayout>

<style>
  .nf { min-height: 100dvh; display: grid; place-content: center; gap: 12px; padding: 24px; text-align: center; }
  .nf__code { font-family: var(--font-display); font-size: 6rem; font-weight: 800; color: var(--accent); line-height: 1; }
  .nf h1 { font-family: var(--font-display); font-size: 1.75rem; }
  .nf p { color: var(--muted); }
  .nf__links { display: flex; gap: 16px; justify-content: center; }
  .nf__links a { color: var(--text); font-weight: 700; }
</style>
